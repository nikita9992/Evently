@inherits LayoutComponentBase
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<MudThemeProvider Theme="@tema" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Surface">

        @* Hamburguesa — solo en móvil *@
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Dark"
                           Edge="Edge.Start"
                           OnClick="ToogleDrawer" />
        </MudHidden>

        @* Logo — sobre fondo blanco se ve en color sin filtro *@
        <img src="img/logo-evently.png"
             alt="Evently"
             class="logoNavbar ml-2"
             @onclick="@(() => Navegacion.NavigateTo("/"))" />



        <MudSpacer />

        @* Enlaces — solo en escritorio *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <nav class="enlacesNavbarEscritorio mr-4">
                <a href="/" class="enlaceNavbar">Inicio</a>
                <a href="/actividades" class="enlaceNavbar">Actividades</a>
                <a href="/sobre-nosotros" class="enlaceNavbar">Sobre nosotros</a>
                <a href="/contacto" class="enlaceNavbar">Contacto</a>
            </nav>
        </MudHidden>

        @* Acciones derecha — escritorio *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                           Color="Color.Dark"
                           Href="/carrito"
                           Title="Mi carrito" />

            @if (EstadoAuth.EstaAutenticado)
            {
                <MudMenu Icon="@Icons.Material.Filled.AccountCircle"
                         Color="Color.Dark"
                         AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight">
                    <ChildContent>
                        <MudMenuItem>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @EstadoAuth.Email
                            </MudText>
                        </MudMenuItem>
                        <MudDivider />
                        @if (EstadoAuth.EsAdministrador)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.AdminPanelSettings"
                                         Href="/admin/dashboard">
                                Panel Admin
                            </MudMenuItem>
                            <MudDivider />
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.Person" Href="/perfil">Mi perfil</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Receipt" Href="/mispedidos">Mis pedidos</MudMenuItem>
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="CerrarSesion">Cerrar sesión</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Dark"
                               Href="/login"
                               Title="Iniciar sesión" />
            }
        </MudHidden>

        @* Acciones móvil — carrito + icono usuario *@
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudIconButton Icon="@Icons.Material.Filled.ShoppingCart"
                           Color="Color.Dark"
                           Href="/carrito"
                           Title="Mi carrito" />
            @if (EstadoAuth.EstaAutenticado)
            {
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Dark"
                               OnClick="ToogleDrawer"
                               Title="Mi cuenta" />
            }
            else
            {
                <MudIconButton Icon="@Icons.Material.Filled.AccountCircle"
                               Color="Color.Dark"
                               Href="/login"
                               Title="Iniciar sesión" />
            }
        </MudHidden>

    </MudAppBar>

    @* Drawer temporal — se cierra solo al ampliar ventana *@
    <MudDrawer @bind-Open="@drawerAbierto"
               Elevation="1"
               Variant="@DrawerVariant.Temporary"
               Width="220px">
        <MudDrawerHeader>
            <img src="img/logo-evently.png"
                 alt="Evently"
                 style="height:32px; object-fit:contain;" />
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Home">Inicio</MudNavLink>
            <MudNavLink Href="/actividades"
                        Icon="@Icons.Material.Filled.EventNote">Actividades</MudNavLink>
            <MudNavLink Href="/sobre-nosotros"
                        Icon="@Icons.Material.Filled.Info">Sobre nosotros</MudNavLink>
            <MudNavLink Href="/contacto"
                        Icon="@Icons.Material.Filled.Mail">Contacto</MudNavLink>
            <MudNavLink Href="/carrito"
                        Icon="@Icons.Material.Filled.ShoppingCart">Carrito</MudNavLink>

            @if (EstadoAuth.EstaAutenticado)
            {
                <MudDivider Class="my-2" />
                <MudNavLink Href="/perfil"
                            Icon="@Icons.Material.Filled.Person">Mi perfil</MudNavLink>
                <MudNavLink Href="/mispedidos"
                            Icon="@Icons.Material.Filled.Receipt">Mis pedidos</MudNavLink>
                @if (EstadoAuth.EsAdministrador)
                {
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.caption"
                             Class="px-4 py-1 mud-text-secondary">
                        ADMINISTRACIÓN
                    </MudText>
                    <MudNavLink Href="/admin/actividades"
                                Icon="@Icons.Material.Filled.EventNote">Gestión Actividades</MudNavLink>
                    <MudNavLink Href="/admin/categorias"
                                Icon="@Icons.Material.Filled.Category">Gestión Categorías</MudNavLink>
                    <MudNavLink Href="/admin/pedidos"
                                Icon="@Icons.Material.Filled.Receipt">Gestión Pedidos</MudNavLink>
                    <MudNavLink Href="/admin/clientes"
                                Icon="@Icons.Material.Filled.People">Gestión Clientes</MudNavLink>
                }
                <MudDivider Class="my-2" />
                <MudNavLink Icon="@Icons.Material.Filled.Logout"
                            OnClick="CerrarSesion">Cerrar sesión</MudNavLink>
            }
            else
            {
                <MudDivider Class="my-2" />
                <MudNavLink Href="/login"
                            Icon="@Icons.Material.Filled.AccountCircle">Iniciar sesión</MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="d-flex flex-column" Style="min-height:100vh">
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 flex-grow-1">
            @Body
        </MudContainer>

        <footer class="pie">
            <section class="contenidoPie">
                <section class="logoPie">
                    <img src="img/logo-evently.png" alt="Evently" class="imagenLogoPie" />
                </section>
                <nav>
                    <p class="tituloPie">Explorar</p>
                    <ul class="listaEnlacesPie">
                        <li><a href="/" class="enlacePie">Inicio</a></li>
                        <li><a href="/actividades" class="enlacePie">Actividades</a></li>
                        @if (EstadoAuth.EstaAutenticado)
                        {
                            <li><a href="/perfil" class="enlacePie">Mi perfil</a></li>
                        }
                        else
                        {
                            <li><a href="/login" class="enlacePie">Iniciar sesión</a></li>
                        }
                    </ul>
                </nav>
                <nav>
                    <p class="tituloPie">Información</p>
                    <ul class="listaEnlacesPie">
                        <li><a href="/sobre-nosotros" class="enlacePie">Sobre nosotros</a></li>
                        <li><a href="/contacto" class="enlacePie">Contacto</a></li>
                        <li><a href="/terminos" class="enlacePie">Términos y condiciones</a></li>
                    </ul>
                </nav>
            </section>
            <hr class="separadorPie" />
            <section class="fondoPie">
                <span>© @DateTime.Now.Year Evently. Todos los derechos reservados.</span>
            </section>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerAbierto = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EstadoAuth.CargarDesdeLocalStorageAsync();
            EstadoAuth.OnCambio += StateHasChanged;

            if (EstadoAuth.EsAdministrador)
            {
                Navegacion.NavigateTo("/admin/dashboard");
                return;
            }

            StateHasChanged();
        }
    }

    private void ToogleDrawer()
    {
        drawerAbierto = !drawerAbierto;
    }

    private async Task CerrarSesion()
    {
        await EstadoAuth.CerrarSesionAsync();
        Snackbar.Add("Sesión cerrada correctamente", Severity.Info);
        Navegacion.NavigateTo("/");
        drawerAbierto = false;
    }

    private MudTheme tema = new MudTheme
    {
        PaletteLight = new PaletteLight
        {
            AppbarBackground = "#ffffff",
            AppbarText = "#1e293b"
        }
    };
}