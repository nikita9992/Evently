@inherits LayoutComponentBase
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<MudThemeProvider Theme="temaAdministrador" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Barra superior *@
    <MudAppBar Elevation="1" Dense="true" Class="barraSuperior">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="alternarMenuLateral" />
        <MudText Typo="Typo.h6"
                 Class="tituloAplicacion"
                 @onclick='@(() => Navegacion.NavigateTo("/admin/dashboard"))'>
            Evently <span class="resaltadoTitulo">Admin</span>
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="correoUsuario mr-2 d-none d-sm-flex">
            @EstadoAuth.Email
        </MudText>
    </MudAppBar>

    @* Menú lateral *@
    <MudDrawer @bind-Open="menuLateralAbierto"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Breakpoint="Breakpoint.Md"
               Class="panelLateral">

        <nav class="contenedorEnlaces">
            <p class="etiquetaGestion">GESTIÓN</p>

            <MudNavMenu>                
                <MudNavLink Href="/admin/actividades"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.EventNote">
                    Actividades
                </MudNavLink>
                <MudNavLink Href="/admin/categorias"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Category">
                    Categorías
                </MudNavLink>
                <MudNavLink Href="/admin/pedidos"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Receipt">
                    Pedidos
                </MudNavLink>
                <MudNavLink Href="/admin/clientes"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.People">
                    Clientes
                </MudNavLink>
                <MudNavLink Href="/admin/usuarios"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.ManageAccounts">
                    Usuarios
                </MudNavLink>
                <MudNavLink Href="/admin/estados"
                            Match="NavLinkMatch.Prefix"
                            Icon="@Icons.Material.Filled.Flag">
                    Estados
                </MudNavLink>
            </MudNavMenu>

            <div class="separadorNavegacion"></div>

            <button @onclick="CerrarSesion" class="botonCerrarSesion">
                <span class="material-icons iconoNavegacion">logout</span>
                <span class="textoNavegacion">Cerrar sesión</span>
            </button>
        </nav>
    </MudDrawer>

    @* Contenido principal *@
    <MudMainContent Class="fondoPrincipal">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4 pa-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    // Controla si el menú lateral está abierto o cerrado
    private bool menuLateralAbierto = true;

    protected override async Task OnAfterRenderAsync(bool primeraCarga)
    {
        if (primeraCarga)
        {
            // Cargamos el token guardado en el navegador
            await EstadoAuth.CargarDesdeLocalStorageAsync();

            // Si no es administrador lo mandamos al login
            if (!EstadoAuth.EsAdministrador)
            {
                Navegacion.NavigateTo("/login");
                return;
            }
            EstadoAuth.OnCambio += StateHasChanged;
            StateHasChanged();
        }
    }

    // Abre o cierra el menú lateral
    private void alternarMenuLateral()
    {
        menuLateralAbierto = !menuLateralAbierto;
    }

    // Cierra la sesión y redirige al login
    private async Task CerrarSesion()
    {
        await EstadoAuth.CerrarSesionAsync();
        Snackbar.Add("Sesión cerrada", Severity.Info);
        Navegacion.NavigateTo("/login");
    }

    // Tema de colores del panel de administración
    private MudTheme temaAdministrador = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#7c6fee",
            Secondary = "#06b6d4",
            Success = "#22c55e",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Background = "#f1f5f9",
            Surface = "#ffffff",
            AppbarBackground = "#1a2236",
            DrawerBackground = "#1a2236",
        }
    };
}