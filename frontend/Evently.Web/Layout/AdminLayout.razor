@inherits LayoutComponentBase
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar

<MudThemeProvider Theme="temaAdmin" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Barra superior -->
    <MudAppBar Elevation="1" Style="background:#1a2236;">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="ToogleDrawer" />
        <MudText Typo="Typo.h6"
                 Style="font-weight:700; color:white; letter-spacing:0.5px; cursor:pointer;"
                 @onclick='@(() => Navegacion.NavigateTo("/admin/dashboard"))'>
            Evently <span style="color:#7c6fee;">Admin</span>
        </MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Style="color:#94a3b8;" Class="mr-2 d-none d-sm-flex">
            @EstadoAuth.Email
        </MudText>
    </MudAppBar>

    <!-- Menú lateral responsive -->
    <MudDrawer @bind-Open="drawerAbierto"
               Elevation="0"
               Breakpoint="Breakpoint.Md"
               Style="background:#1a2236; border-right: 1px solid #243044;">

        <div style="padding:24px 16px 16px 16px; border-bottom: 1px solid #243044;">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings"
                     Style="color:#7c6fee; font-size:20px; margin-right:8px;" />
            <span style="color:#e2e8f0; font-weight:700; letter-spacing:1px; font-size:13px;">
                EVENTLY
            </span>
        </div>

        <div style="padding:16px 8px;">
            <p style="color:#4a5568; font-size:10px; font-weight:700; letter-spacing:1.5px; padding:0 8px; margin-bottom:8px;">
                GESTIÓN
            </p>

            <a href="/admin/actividades"
               style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; text-decoration:none; color:#94a3b8; margin-bottom:2px; transition:all 0.2s;"
               onmouseover="this.style.background='rgba(124,111,238,0.15)'; this.style.color='#fff';"
               onmouseout="this.style.background='transparent'; this.style.color='#94a3b8';">
                <span class="material-icons" style="font-size:20px;">event_note</span>
                <span style="font-size:14px; font-weight:500;">Actividades</span>
            </a>

            <a href="/admin/categorias"
               style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; text-decoration:none; color:#94a3b8; margin-bottom:2px; transition:all 0.2s;"
               onmouseover="this.style.background='rgba(124,111,238,0.15)'; this.style.color='#fff';"
               onmouseout="this.style.background='transparent'; this.style.color='#94a3b8';">
                <span class="material-icons" style="font-size:20px;">category</span>
                <span style="font-size:14px; font-weight:500;">Categorías</span>
            </a>

            <a href="/admin/pedidos"
               style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; text-decoration:none; color:#94a3b8; margin-bottom:2px; transition:all 0.2s;"
               onmouseover="this.style.background='rgba(124,111,238,0.15)'; this.style.color='#fff';"
               onmouseout="this.style.background='transparent'; this.style.color='#94a3b8';">
                <span class="material-icons" style="font-size:20px;">receipt</span>
                <span style="font-size:14px; font-weight:500;">Pedidos</span>
            </a>

            <a href="/admin/clientes"
               style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; text-decoration:none; color:#94a3b8; margin-bottom:2px; transition:all 0.2s;"
               onmouseover="this.style.background='rgba(124,111,238,0.15)'; this.style.color='#fff';"
               onmouseout="this.style.background='transparent'; this.style.color='#94a3b8';">
                <span class="material-icons" style="font-size:20px;">people</span>
                <span style="font-size:14px; font-weight:500;">Clientes</span>
            </a>

            <div style="border-top:1px solid #243044; margin:16px 0;"></div>

            <button @onclick="CerrarSesion"
                    style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; background:transparent; border:none; color:#ef4444; cursor:pointer; width:100%; text-align:left; transition:all 0.2s;"
                    onmouseover="this.style.background='rgba(239,68,68,0.1)';"
                    onmouseout="this.style.background='transparent';">
                <span class="material-icons" style="font-size:20px;">logout</span>
                <span style="font-size:14px; font-weight:500;">Cerrar sesión</span>
            </button>
        </div>
    </MudDrawer>

    <!-- Contenido -->
    <MudMainContent Style="background:#f1f5f9; min-height:100vh;">
        <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4 pa-sm-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerAbierto = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EstadoAuth.CargarDesdeLocalStorageAsync();
            if (!EstadoAuth.EsAdministrador)
            {
                Navegacion.NavigateTo("/login");
                return;
            }
            EstadoAuth.OnCambio += StateHasChanged;
            StateHasChanged();
        }
    }

    private void ToogleDrawer()
    {
        drawerAbierto = !drawerAbierto;
    }

    private async Task CerrarSesion()
    {
        await EstadoAuth.CerrarSesionAsync();
        Snackbar.Add("Sesión cerrada", Severity.Info);
        Navegacion.NavigateTo("/login");
    }

    private MudTheme temaAdmin = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#7c6fee",
            Secondary = "#06b6d4",
            Success = "#22c55e",
            Warning = "#f59e0b",
            Error = "#ef4444",
            Background = "#f1f5f9",
            Surface = "#ffffff",
            AppbarBackground = "#1a2236",
            DrawerBackground = "#1a2236",
        }
    };
}