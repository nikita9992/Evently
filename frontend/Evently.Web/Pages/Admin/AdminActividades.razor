@page "/admin/actividades"
@layout AdminLayout
@inject ActividadService ActividadService
@inject CategoriaService CategoriaService
@inject ISnackbar Snackbar
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion

<PageTitle>Admin — Actividades</PageTitle>

<main id="pagina-admin-actividades">

    <header class="cabecera-pagina">
        <MudText Typo="Typo.h4" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Class="mr-2" />
            Gestión de Actividades
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AbrirFormularioCrear"
                   Class="mb-4">
            Nueva actividad
        </MudButton>
    </header>

    @* Filtros *@
    <section id="seccion-filtros">
        <MudExpansionPanels Class="mb-4">
            <MudExpansionPanel Text="Filtros de búsqueda"
                               Icon="@Icons.Material.Filled.FilterList">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="filtroPorTitulo"
                                      Label="Buscar por título"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnKeyUp="FiltrarActividades" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="filtroPorCategoria"
                                   Label="Filtrar por categoría"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="int?" Value="null">
                                Todas las categorías
                            </MudSelectItem>

                            @foreach (var categoria in categorias)
                            {
                                <MudSelectItem T="int?" Value="categoria.IdCategoria">
                                    @categoria.NombreCatego
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="filtroPorCiudad"
                                   Label="Filtrar por ciudad"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="string" Value="@("")">
                                Todas las ciudades
                            </MudSelectItem>
                            @foreach (var ciudad in ciudadesDisponibles)
                            {
                                <MudSelectItem T="string" Value="@ciudad">
                                    @ciudad
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.FilterList"
                                   OnClick="FiltrarActividades">
                            Aplicar filtros
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="LimpiarFiltros"
                                   Class="ml-2">
                            Limpiar filtros
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </section>
    
    @* Tabla de actividades *@
    <section id="seccion-tabla-actividades">
        @if (cargando)
        {
            <aside class="contenedor-cargando">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </aside>
        }
        else
        {
            <MudTable Items="actividadesPaginadas" Hover="true" Striped="true" Elevation="3" RowsPerPage="10">
                <HeaderContent>
                    <MudTh>Imagen</MudTh>
                    <MudTh>Título</MudTh>
                    <MudTh>Ciudad</MudTh>
                    @* <MudTh>Categoría</MudTh> *@
                    <MudTh>Precio</MudTh>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Plazas</MudTh>
                    <MudTh>Destacada</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd>
                        @if (context.Imagenes.Any())
                        {
                            <img src="@context.Imagenes[0]"
                                 alt="@context.Titulo"
                                 class="miniatura-tabla" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported"
                                     Color="Color.Default" />
                        }
                </MudTd>

                <MudTd>@context.Titulo</MudTd>

                <MudTd>@(context.Ciudad ?? "—")</MudTd>

                <MudTd>@context.Precio.ToString("C")</MudTd>

                <MudTd>
                    @(context.FechaActiv.HasValue
                                        ? context.FechaActiv.Value.ToString("dd/MM/yyyy HH:mm")
                                        : "—")
                </MudTd>

                    <MudTd>
                    @if (context.CupoMaximo.HasValue)
                        {
                            @($"{context.PlazasDisponibles} / {context.CupoMaximo}")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </MudTd>

                    <MudTd>
                        <MudCheckBox T="bool"
                                     Value="@context.EsDestacada"
                                     ValueChanged="@((bool valor) => CambiarDestacadaDesdeTabla(context, valor))"
                                     Color="Color.Primary" />
                    </MudTd>

                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       OnClick="@(() => AbrirFormularioEditar(context))" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => ConfirmarEliminar(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (totalPaginas > 0)
            {
                <section class="controlesDeParginacion">
                    <MudText Typo="Typo.body2">Mostrar:</MudText>
                    <MudSelect T="int"
                               Value="actividadesPorPagina"
                               ValueChanged="@((int v) => { actividadesPorPagina = v; paginaActual = 1; ActualizarPaginacion(); })"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="selectorPagina">
                        @foreach (var opcion in opcionesPagina)
                        {
                            <MudSelectItem T="int" Value="opcion">@opcion por página</MudSelectItem>
                        }
                    </MudSelect>
                    <MudPagination Count="totalPaginas"
                                   Selected="paginaActual"
                                   SelectedChanged="@((int p) => { paginaActual = p; ActualizarPaginacion(); })"
                                   Color="Color.Primary" />
                </section>
            }
        }
    </section>

</main>

@* Diálogo crear/editar *@
<MudDialog @bind-Visible="dialogoAbierto"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(modoEdicion ? "Editar actividad" : "Nueva actividad")
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudForm @ref="formularioMud" @bind-IsValid="formularioValido">
        <MudTextField @bind-Value="formulario.Titulo"
                      Label="Título"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true"
                      RequiredError="El título es obligatorio" />

        <MudSelect T="int" @bind-Value="formulario.IdCategoria"
                   Label="Categoría"
                   Variant="Variant.Outlined"
                   Class="mb-3"
                   Required="true"
                   RequiredError="La categoría es obligatoria">
            @foreach (var categoria in categorias)
            {
                <MudSelectItem T="int" Value="categoria.IdCategoria">
                    @categoria.NombreCatego
                </MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="formulario.Descripcion"
                      Label="Descripción"
                      Variant="Variant.Outlined"
                      Lines="3"
                      Class="mb-3"
                      Required="true"
                      RequiredError="La descripción es obligatoria"
                      MaxLength="500"
                      Counter="500" />

        <MudTextField @bind-Value="formulario.Ciudad"
                      Label="Ciudad"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true"
                      RequiredError="La ciudad es obligatoria" />

        <MudTextField @bind-Value="formulario.Ubicacion"
                      Label="Ubicación"
                      Variant="Variant.Outlined"
                      Class="mb-3"
                      Required="true"
                      RequiredError="La ubicación es obligatoria" />

        <MudTextField @bind-Value="formulario.PrecioCadena"
                      Label="Precio (€)"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.End"
                      AdornmentText="€"
                      Class="mb-3"
                      Placeholder="0,00"
                      Error="errorPrecio"
                      ErrorText="@mensajeErrorPrecio" />
        @* Fecha y hora *@
        <MudGrid Class="mb-3">
            <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="fechaSeleccionada"
                                   Label="Fecha de la actividad"
                                   Variant="Variant.Outlined"
                                   Error="errorFecha"
                                   ErrorText="@mensajeErrorFecha" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTimePicker @bind-Time="horaSeleccionada"
                               Label="Hora de la actividad"
                               Variant="Variant.Outlined"
                               AmPm="false" />
            </MudItem>
        </MudGrid>

        @* Cupo máximo con switch *@
        <MudSwitch @bind-Value="tieneCupoMaximo"
                   Color="Color.Primary"
                   Label="Limitar número de plazas"
                   Class="mb-2" />

        @if (tieneCupoMaximo)
        {
            <MudNumericField @bind-Value="formulario.CupoMaximo"
                             Label="Cupo máximo de plazas"
                             Variant="Variant.Outlined"
                             Min="1"
                             Class="mb-3"
                             Adornment="Adornment.End"
                             AdornmentText="plazas" />
        }

        <MudCheckBox T="bool"
                     @bind-Value="formulario.EsDestacada"
                     Color="Color.Primary"
                     Label="Mostrar en la página de inicio"
                     Class="mb-3" />

        @* Imágenes *@
        <MudText Typo="Typo.subtitle2" Class="mt-2 mb-2">
            Imágenes (máximo 8)
        </MudText>

        <section class="lista-campos-imagen">
            @for (int i = 0; i < listaImagenes.Count; i++)
            {
                var indice = i;

                <article class="fila-imagen">
                    <MudTextField @bind-Value="listaImagenes[indice]"
                                  Label="@($"URL imagen {indice + 1}")"
                                  Variant="Variant.Outlined"
                                  FullWidth="true"
                                  Placeholder="https://ejemplo.com/imagen.jpg"
                                  Error="@(errorImagenes && indice == 0)" />

                        @if (errorImagenes && indice == 0)
                        {
                            <MudText Color="Color.Error"
                                     Typo="Typo.caption"
                                     Class="mt-1">
                                Debes añadir al menos una imagen
                            </MudText>
                        }

                    @if (!string.IsNullOrEmpty(listaImagenes[indice]))
                    {
                        <img src="@listaImagenes[indice]"
                             alt="Vista previa de la imagen"
                             class="miniatura-preview"/>
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="@(() => EliminarImagen(indice))" />
                </article>
            }
        </section>

        @if (listaImagenes.Count < 8)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AnadirCampoImagen"
                       Size="Size.Small"
                       Class="mt-1">
                Añadir imagen
            </MudButton>
        }
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="CerrarDialogo">
            Cancelar
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="GuardarActividad">
            @(modoEdicion ? "Guardar cambios" : "Crear")
        </MudButton>
    </DialogActions>
</MudDialog>

@* Confirmar eliminación *@
<MudDialog @bind-Visible="dialogoEliminarAbierto">
    <TitleContent>
        <MudText Typo="Typo.h6" Color="Color.Error">
            ¿Eliminar actividad?
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudText>
            ¿Estás seguro de que quieres eliminar
            <strong>@actividadAEliminar?.Titulo</strong>?
            Esta acción no se puede deshacer.
        </MudText>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => dialogoEliminarAbierto = false)">
            Cancelar
        </MudButton>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   OnClick="EliminarActividad">
            Eliminar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool dialogoAbierto = false;
    private bool dialogoEliminarAbierto = false;
    private bool modoEdicion = false;
    private CrearActividadDto formulario = new();
    private DateTime? fechaSeleccionada;
    private TimeSpan? horaSeleccionada;
    private bool tieneCupoMaximo = false;
    private int actividadEditandoId;
    private ActividadDto? actividadAEliminar;
    private List<string> listaImagenes = new() { "" };    
    private MudForm formularioMud = null!;
    private bool formularioValido = false;
    private string tokenAdmin => EstadoAuth.Token;


    private string filtroPorTitulo = string.Empty;
    private int? filtroPorCategoria = null;
    private bool cargando = true;
    private string filtroPorCiudad = string.Empty;

    private List<ActividadDto> actividades = new();
    private List<ActividadDto> todasLasActividades = new();
    private List<ActividadDto> actividadesFiltradas = new();
    private List<ActividadDto> actividadesPaginadas = new();


    private List<CategoriaDto> categorias = new();
    private List<string> ciudadesDisponibles = new();

    private int paginaActual = 1;
    private int actividadesPorPagina = 10;
    private int totalPaginas = 0;
    private List<int> opcionesPagina = new() { 5, 10, 20, 50 };

    private bool errorImagenes = false;
    private bool errorFecha = false;
    private bool errorPrecio = false;
    private string mensajeErrorFecha = string.Empty;
    private string mensajeErrorPrecio = string.Empty;

    private void ActualizarPaginacion()
    {
        totalPaginas = (int)Math.Ceiling(actividadesFiltradas.Count / (double)actividadesPorPagina);

        actividadesPaginadas = actividadesFiltradas
            .Skip((paginaActual - 1) * actividadesPorPagina)
            .Take(actividadesPorPagina)
            .ToList();
    }

    private async Task FiltrarActividades()
    {
        cargando = true;
        paginaActual = 1;

        actividades = await ActividadService.ObtenerTodasAsync(
            filtroPorCategoria,
            filtroPorTitulo,
            filtroPorCiudad);

        actividadesFiltradas = actividades.ToList();

        ActualizarPaginacion();

        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!EstadoAuth.EstaAutenticado)
            {
                await EstadoAuth.CargarDesdeLocalStorageAsync();
                StateHasChanged();
            }

            if (!EstadoAuth.EsAdministrador)
            {
                Navegacion.NavigateTo("/");
                return;
            }

            await CargarDatos();
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;

        categorias = await CategoriaService.ObtenerTodasAsync();

        actividades = await ActividadService.ObtenerTodasAsync();
        todasLasActividades = actividades.ToList();
        actividadesFiltradas = actividades.ToList();

        ciudadesDisponibles = todasLasActividades
            .Where(a => !string.IsNullOrEmpty(a.Ciudad))
            .Select(a => a.Ciudad ?? string.Empty)
            .Where(c => c != string.Empty)
            .Distinct()
            .OrderBy(c => c)
            .ToList();

        ActualizarPaginacion();

        cargando = false;
    }

    private async Task LimpiarFiltros()
    {
        filtroPorTitulo = string.Empty;
        filtroPorCategoria = null;
        filtroPorCiudad = string.Empty;

        await FiltrarActividades();
    }

    private void AbrirFormularioCrear()
    {
        formulario = new CrearActividadDto();

        if (categorias.Count > 0)
        {
            formulario.IdCategoria = categorias[0].IdCategoria;
        }

        fechaSeleccionada = null;
        horaSeleccionada = null;
        tieneCupoMaximo = false;
        listaImagenes = new List<string> { "" };
        errorImagenes = false;
        errorFecha = false;
        errorPrecio = false;
        mensajeErrorFecha = string.Empty;
        mensajeErrorPrecio = string.Empty;
        modoEdicion = false;
        dialogoAbierto = true;
    }

    private void AbrirFormularioEditar(ActividadDto actividad)
    {
        formulario = new CrearActividadDto
        {
            IdCategoria = actividad.IdCategoria,
            Titulo = actividad.Titulo,
            Descripcion = actividad.Descripcion,
            Ciudad = actividad.Ciudad ?? string.Empty,
            Ubicacion = actividad.Ubicacion ?? string.Empty,
            Precio = actividad.Precio,
            CupoMaximo = actividad.CupoMaximo,
            EsDestacada = actividad.EsDestacada
        };

        fechaSeleccionada = actividad.FechaActiv?.Date;
        horaSeleccionada = actividad.FechaActiv?.TimeOfDay;
        tieneCupoMaximo = actividad.CupoMaximo.HasValue;
        actividadEditandoId = actividad.IdActividad;

        listaImagenes = actividad.Imagenes.Any()
            ? actividad.Imagenes.ToList()
            : new List<string> { "" };

        modoEdicion = true;
        dialogoAbierto = true;
        errorImagenes = false;
        errorFecha = false;
        errorPrecio = false;
        mensajeErrorFecha = string.Empty;
        mensajeErrorPrecio = string.Empty;
    }

    private async Task GuardarActividad()
    {
        await formularioMud.ValidateAsync();

        errorImagenes = false;
        errorFecha = false;
        errorPrecio = false;
        mensajeErrorFecha = string.Empty;
        mensajeErrorPrecio = string.Empty;

        if (!fechaSeleccionada.HasValue)
        {
            errorFecha = true;
            mensajeErrorFecha = "La fecha de la actividad es obligatoria";
        }
        else if (fechaSeleccionada.Value.Date < DateTime.Today)
        {
            errorFecha = true;
            mensajeErrorFecha = "La fecha de la actividad no puede ser anterior a hoy";
        }

        if (string.IsNullOrWhiteSpace(formulario.PrecioCadena))
        {
            errorPrecio = true;
            mensajeErrorPrecio = "El precio es obligatorio";
        }
        else if (formulario.Precio <= 0)
        {
            errorPrecio = true;
            mensajeErrorPrecio = "El precio debe ser mayor que 0";
        }

        var imagenesValidas = listaImagenes
            .Where(url => !string.IsNullOrWhiteSpace(url))
            .ToList();

        errorImagenes = imagenesValidas.Count == 0;

        if (!formularioValido || errorFecha || errorPrecio || errorImagenes)
        {
            return;
        }

        var fecha = fechaSeleccionada.Value.Date;
        var hora = horaSeleccionada ?? TimeSpan.Zero;
        formulario.FechaActiv = DateTime.SpecifyKind(fecha + hora, DateTimeKind.Utc);

        if (!tieneCupoMaximo)
            formulario.CupoMaximo = null;

        formulario.Imagenes = imagenesValidas;

        if (modoEdicion)
        {
            var resultado = await ActividadService.EditarAsync(
                actividadEditandoId, formulario, tokenAdmin);

            if (resultado != null)
            {
                Snackbar.Add("Actividad actualizada correctamente", Severity.Success);
                dialogoAbierto = false;
                await CargarDatos();
            }
            else
            {
                Snackbar.Add("Error al actualizar la actividad", Severity.Error);
            }
        }
        else
        {
            var resultado = await ActividadService.CrearAsync(formulario, tokenAdmin);

            if (resultado != null)
            {
                Snackbar.Add("Actividad creada correctamente", Severity.Success);
                dialogoAbierto = false;
                await CargarDatos();
            }
            else
            {
                Snackbar.Add("Error al crear la actividad", Severity.Error);
            }
        }
    }

    private async Task CambiarDestacadaDesdeTabla(ActividadDto actividad, bool esDestacada)
    {
        var dto = new CrearActividadDto
        {
            IdCategoria = actividad.IdCategoria,
            Titulo = actividad.Titulo,
            Descripcion = actividad.Descripcion,
            Ciudad = actividad.Ciudad ?? string.Empty,
            Ubicacion = actividad.Ubicacion ?? string.Empty,
            Precio = actividad.Precio,
            FechaActiv = actividad.FechaActiv,
            CupoMaximo = actividad.CupoMaximo,
            EsDestacada = esDestacada,
            Imagenes = actividad.Imagenes.ToList()
        };

        var resultado = await ActividadService.EditarAsync(
                        actividad.IdActividad,
                        dto,
                        tokenAdmin);

        if (resultado != null)
        {
            actividad.EsDestacada = esDestacada;

            if (esDestacada)
                Snackbar.Add("Actividad añadida a la página de inicio", Severity.Success);
            else
                Snackbar.Add("Actividad retirada de la página de inicio", Severity.Info);
        }
        else
        {
            Snackbar.Add("No se pudo actualizar la actividad destacada", Severity.Error);
        }

        await CargarDatos();
    }

    private void AnadirCampoImagen()
    {
        if (listaImagenes.Count < 8)
            listaImagenes.Add("");
    }

    private void EliminarImagen(int indice)
    {
        listaImagenes.RemoveAt(indice);

        if (listaImagenes.Count == 0)
            listaImagenes.Add("");
    }

    private void ConfirmarEliminar(ActividadDto actividad)
    {
        actividadAEliminar = actividad;
        dialogoEliminarAbierto = true;
    }

    private async Task EliminarActividad()
    {
        if (actividadAEliminar == null) return;

        var (exito, mensaje) = await ActividadService.EliminarAsync(actividadAEliminar.IdActividad, tokenAdmin);

        if (exito)
            Snackbar.Add(mensaje, Severity.Success);
        else
            Snackbar.Add(mensaje, Severity.Error);

        dialogoEliminarAbierto = false;
        await CargarDatos();
    }

    private void CerrarDialogo()
    {
        dialogoAbierto = false;
    }
}