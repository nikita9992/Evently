@page "/admin/dashboard"
@layout AdminLayout
@inject PedidoService PedidoService
@inject NavigationManager Navegacion
@inject EstadoAuthService EstadoAuth

<PageTitle>Evently Admin</PageTitle>

@if (cargando)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    @* Tarjetas de estadísticas principales *@
    <section class="rejillaTarjetas">

        <article class="tarjetaEstadistica tarjetaPedidos">
            <p class="etiquetaTarjeta">PEDIDOS</p>
            <p class="valorTarjeta">@totalPedidos</p>
            <p class="descripcionTarjeta">Total realizados</p>
        </article>

        <article class="tarjetaEstadistica tarjetaIngresos">
            <p class="etiquetaTarjeta">INGRESOS TOTALES</p>
            <p class="valorTarjeta">@ingresosTotales.ToString("C")</p>
            <p class="descripcionTarjeta">Pedidos confirmados</p>
        </article>

        <article class="tarjetaEstadistica tarjetaTicket">
            <p class="etiquetaTarjeta">TICKET MEDIO</p>
            <p class="valorTarjeta">@ticketMedio.ToString("C")</p>
            <p class="descripcionTarjeta">Por pedido confirmado</p>
        </article>

        <article class="tarjetaEstadistica tarjetaConfirmacion">
            <p class="etiquetaTarjeta">TASA CONFIRMACIÓN</p>
            <p class="valorTarjeta">@tasaConfirmacion%</p>
            <p class="descripcionTarjeta">Pedidos confirmados</p>
        </article>

    </section>

    @* Sección inferior con gráfico y últimos pedidos *@
    <section class="rejillaGraficos">

        @* Gráfico de distribución de pedidos *@
        <article class="tarjetaGrafico">
            <h2 class="tituloTarjeta">Estado de pedidos</h2>
            <p class="subtituloTarjeta">Distribución actual</p>

            @if (totalPedidos > 0)
            {
                <section class="donutSinLeyenda">
                    <MudChart T="double"
                              ChartType="ChartType.Donut"
                              ChartSeries="@datosGrafico.AsChartDataSet()"
                              ChartLabels="@etiquetasGrafico"
                              Width="100%"
                              Height="200px"
                              ChartOptions="@opcionesGrafico" />
                </section>
            }
            else
            {
                <section class="contenedorSinDatos">
                    <p class="textoSinDatos">Sin datos todavía</p>
                </section>
            }

            @* Leyenda manual del gráfico *@
            <section class="leyendaGrafico">
                <article class="itemLeyenda">
                    <span class="puntoLeyenda puntoConfirmado"></span>
                    <span class="textoLeyenda">Confirmados: <strong>@pedidosConfirmados</strong></span>
                </article>
                <article class="itemLeyenda">
                    <span class="puntoLeyenda puntoPendiente"></span>
                    <span class="textoLeyenda">Pendientes: <strong>@pedidosPendientes</strong></span>
                </article>
                <article class="itemLeyenda">
                    <span class="puntoLeyenda puntoCancelado"></span>
                    <span class="textoLeyenda">Cancelados: <strong>@pedidosCancelados</strong></span>
                </article>
            </section>
        </article>

        @* Lista de últimos pedidos *@
        <article class="tarjetaGrafico">
            <header class="cabeceraTarjeta">
                <section>
                    <h2 class="tituloTarjeta">Últimos pedidos</h2>
                    <p class="subtituloTarjeta">Los 5 más recientes</p>
                </section>
                <MudButton Variant="Variant.Text"
                           Size="Size.Small"
                           Class="botonVerTodos"
                           OnClick='@(() => Navegacion.NavigateTo("/admin/pedidos"))'>
                    Ver todos →
                </MudButton>
            </header>

            @if (!ultimosPedidos.Any())
            {
                <p class="textoSinDatos">No hay pedidos todavía</p>
            }
            else
            {
                @foreach (var pedido in ultimosPedidos)
                {
                    <article class="filaPedido">
                        <section>
                            <p class="nombrePedido">#@pedido.IdPedido — @pedido.NombreCliente</p>
                            <p class="fechaPedido">@pedido.FechaConfirm.ToString("dd/MM/yyyy")</p>
                        </section>
                        <footer class="importePedido">
                            <p class="totalPedido">@pedido.Detalles.Sum(d => d.ImporteLinea).ToString("C")</p>
                            @if (pedido.NombreEstado == "Confirmado")
                            {
                                <span class="estadoPedido estadoConfirmado">Confirmado</span>
                            }
                            else if (pedido.NombreEstado == "Cancelado")
                            {
                                <span class="estadoPedido estadoCancelado">Cancelado</span>
                            }
                            else
                            {
                                <span class="estadoPedido estadoPendiente">@pedido.NombreEstado</span>
                            }
                        </footer>
                    </article>
                }
            }
        </article>

    </section>
}

@code {
    private int totalPedidos = 0;
    private int pedidosConfirmados = 0;
    private int pedidosPendientes = 0;
    private int pedidosCancelados = 0;
    private decimal ingresosTotales = 0;
    private decimal ticketMedio = 0;
    private int tasaConfirmacion = 0;
    private List<PedidoDto> ultimosPedidos = new();
    private bool cargando = true;

    private double[] datosGrafico = Array.Empty<double>();
    private string[] etiquetasGrafico = Array.Empty<string>();
    private ChartOptions opcionesGrafico = new ChartOptions
    {
        ChartPalette = new[] { "#746EEA", "#00BDA1", "#00FCE7" }
    };

    protected override async Task OnAfterRenderAsync(bool primeraCarga)
    {
        if (primeraCarga)
        {
            // Cargamos el token guardado en el navegador antes de pedir datos
            await EstadoAuth.CargarDesdeLocalStorageAsync();
            await CargarEstadisticas();
            StateHasChanged();
        }
    }

    private async Task CargarEstadisticas()
    {
        cargando = true;

        // Obtenemos todos los pedidos del backend
        var pedidos = await PedidoService.ObtenerTodosAsync(EstadoAuth.Token);
        totalPedidos = pedidos.Count;

        // Contamos pedidos por estado
        pedidosConfirmados = pedidos.Count(p => p.NombreEstado == "Confirmado");
        pedidosPendientes = pedidos.Count(p => p.NombreEstado == "Pendiente");
        pedidosCancelados = pedidos.Count(p => p.NombreEstado == "Cancelado");

        // Calculamos ingresos totales de pedidos confirmados
        ingresosTotales = pedidos
            .Where(p => p.NombreEstado == "Confirmado")
            .Sum(p => p.Detalles.Sum(d => d.ImporteLinea));

        // Calculamos el ticket medio
        ticketMedio = pedidosConfirmados > 0
            ? ingresosTotales / pedidosConfirmados
            : 0;

        // Calculamos el porcentaje de confirmación
        tasaConfirmacion = totalPedidos > 0
            ? (int)Math.Round((double)pedidosConfirmados / totalPedidos * 100)
            : 0;

        // Tomamos los 5 pedidos más recientes
        ultimosPedidos = pedidos
            .OrderByDescending(p => p.FechaConfirm)
            .Take(5)
            .ToList();

        // Preparamos los datos para el gráfico
        datosGrafico = new double[] { pedidosConfirmados, pedidosPendientes, pedidosCancelados };
        etiquetasGrafico = new[] { "Confirmados", "Pendientes", "Cancelados" };

        cargando = false;
    }
}