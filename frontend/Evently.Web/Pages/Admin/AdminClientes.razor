@page "/admin/clientes"
@layout AdminLayout
@inject ClienteService ClienteService
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion

<PageTitle>Admin - Clientes</PageTitle>

<main id="pagina-admin-clientes">

    <header class="cabecera-pagina">
        <MudText Typo="Typo.h4" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="mr-2" />
            Gestión de Clientes
        </MudText>
    </header>

    <section id="seccion-tabla-clientes">
        @if (cargando)
        {
            <aside class="contenedor-cargando">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </aside>
        }
        else if (!clientes.Any())
        {
            <MudAlert Severity="Severity.Info">No hay clientes registrados.</MudAlert>
        }
        else
        {
            <MudTable Items="clientesPaginados" Hover="true" Striped="true" Elevation="3"
                      Filter="FiltrarCliente">
                <ToolBarContent>
                    <MudTextField @bind-Value="textoBusqueda"
                                  Placeholder="Buscar cliente..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Nombre</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Teléfono</MudTh>
                    <MudTh>Ciudad</MudTh>
                    <MudTh>Dirección</MudTh>
                    <MudTh>Cód. Postal</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.IdCliente</MudTd>
                    <MudTd>@context.Nombre @context.Apellidos</MudTd>
                    <MudTd>@context.EmailUsuario</MudTd>
                    <MudTd>@(context.Telefono ?? "—")</MudTd>
                    <MudTd>@(context.Ciudad ?? "—")</MudTd>
                    <MudTd>@(context.Direccion ?? "—")</MudTd>
                    <MudTd>@(context.CodPostal ?? "—")</MudTd>
                </RowTemplate>
            </MudTable>
            @if (totalPaginas > 0)
            {
                <section class="controlesDeParginacion">
                    <MudText Typo="Typo.body2">Mostrar:</MudText>

                    <MudSelect T="int"
                               Value="clientesPorPagina"
                               ValueChanged="@((int v) => { clientesPorPagina = v; paginaActual = 1; ActualizarPaginacion(); })"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="selectorPagina">
                        @foreach (var opcion in opcionesPagina)
                        {
                            <MudSelectItem T="int" Value="opcion">@opcion</MudSelectItem>
                        }
                    </MudSelect>

                    <MudIconButton Icon="@Icons.Material.Filled.FirstPage"
                                   Color="Color.Primary"
                                   Disabled="@(paginaActual == 1)"
                                   OnClick="IrPrimeraPagina" />

                    <MudPagination Count="totalPaginas"
                                   Selected="paginaActual"
                                   SelectedChanged="@((int p) => { paginaActual = p; ActualizarPaginacion(); })"
                                   Color="Color.Primary" />

                    <MudIconButton Icon="@Icons.Material.Filled.LastPage"
                                   Color="Color.Primary"
                                   Disabled="@(paginaActual == totalPaginas)"
                                   OnClick="IrUltimaPagina" />

                    <MudText Typo="Typo.body2">
                        @paginaActual / @totalPaginas
                    </MudText>
                </section>
            }
        }
    </section>

</main>

@code {
    private List<ClienteDto> clientes = new();
    private List<ClienteDto> clientesPaginados = new();
    private bool cargando = true;
    private string textoBusqueda = string.Empty;
    private int paginaActual = 1;
    private int clientesPorPagina = 10;
    private int totalPaginas = 0;
    private List<int> opcionesPagina = new() { 5, 10, 20, 50 };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!EstadoAuth.EstaAutenticado)
            {
                await EstadoAuth.CargarDesdeLocalStorageAsync();
                StateHasChanged();
            }

            if (!EstadoAuth.EsAdministrador)
            {
                Navegacion.NavigateTo("/");
                return;
            }

            await CargarDatos();
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;
        clientes = await ClienteService.ObtenerTodosAsync(EstadoAuth.Token);
        ActualizarPaginacion();
        cargando = false;
    }

    private void ActualizarPaginacion()
    {
        totalPaginas = (int)Math.Ceiling(clientes.Count / (double)clientesPorPagina);

        clientesPaginados = clientes
            .Skip((paginaActual - 1) * clientesPorPagina)
            .Take(clientesPorPagina)
            .ToList();
    }

    private void IrPrimeraPagina()
    {
        paginaActual = 1;
        ActualizarPaginacion();
    }

    private void IrUltimaPagina()
    {
        paginaActual = totalPaginas;
        ActualizarPaginacion();
    }

    // Filtro de búsqueda
    private bool FiltrarCliente(ClienteDto cliente)
    {
        if (string.IsNullOrEmpty(textoBusqueda)) return true;

        var busqueda = textoBusqueda.ToLower();
        return cliente.Nombre.ToLower().Contains(busqueda)
            || cliente.Apellidos.ToLower().Contains(busqueda)
            || cliente.EmailUsuario.ToLower().Contains(busqueda)
            || (cliente.Ciudad?.ToLower().Contains(busqueda) ?? false);
    }
}
