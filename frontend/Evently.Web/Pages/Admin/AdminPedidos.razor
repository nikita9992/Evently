@page "/admin/pedidos"
@layout AdminLayout
@inject PedidoService PedidoService
@inject EstadoService EstadoService
@inject ISnackbar Snackbar
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion

<PageTitle>Admin — Pedidos</PageTitle>

<main id="pagina-admin-pedidos">

    <header class="cabecera-pagina">
        <MudText Typo="Typo.h4" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
            Gestión de Pedidos
        </MudText>
    </header>

    <section id="seccion-tabla-pedidos">
        @if (cargando)
        {
            <aside class="contenedor-cargando">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </aside>
        }
        else if (!pedidos.Any())
        {
            <MudAlert Severity="Severity.Info">No hay pedidos registrados.</MudAlert>
        }
        else
        {
            <MudTable Items="pedidosPaginados"
                      Hover="true"
                      Striped="true"
                      Elevation="3" >
                <ToolBarContent>
                    <MudTextField @bind-Value="textoBusqueda"
                                  Placeholder="Buscar por pedido o cliente..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Medium"
                                  Class="mt-0"
                                  Immediate="true"
                                  OnKeyUp="FiltrarPedidos" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh>Fecha</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh>Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.IdPedido</MudTd>
                    <MudTd>@context.NombreCliente</MudTd>
                    <MudTd>
                        <MudChip T="string"
                                 Color="@(context.NombreEstado == "Confirmado"
                                        ? Color.Success : Color.Error)"
                             Size="Size.Small">
                        @context.NombreEstado
                    </MudChip>
                </MudTd>
                <MudTd>@context.FechaConfirm.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd>
                    @(context.Detalles.Sum(d => d.ImporteLinea).ToString("C"))
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => VerDetalle(context))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
        @if (totalPaginas > 0)
        {
            <section class="controlesDeParginacion">
                <MudText Typo="Typo.body2">Mostrar:</MudText>

                <MudSelect T="int"
                            Value="pedidosPorPagina"
                            ValueChanged="@((int v) => { pedidosPorPagina = v; paginaActual = 1; ActualizarPaginacion(); })"
                            Variant="Variant.Outlined"
                            Dense="true"
                            Class="selectorPagina">
                    @foreach (var opcion in opcionesPagina)
                    {
                        <MudSelectItem T="int" Value="opcion">@opcion</MudSelectItem>
                    }
                </MudSelect>

                <MudIconButton Icon="@Icons.Material.Filled.FirstPage"
                                Color="Color.Primary"
                                Disabled="@(paginaActual == 1)"
                                OnClick="IrPrimeraPagina" />

                <MudPagination Count="totalPaginas"
                                Selected="paginaActual"
                                SelectedChanged="@((int p) => { paginaActual = p; ActualizarPaginacion(); })"
                                Color="Color.Primary" />

                <MudIconButton Icon="@Icons.Material.Filled.LastPage"
                                Color="Color.Primary"
                                Disabled="@(paginaActual == totalPaginas)"
                                OnClick="IrUltimaPagina" />

                <MudText Typo="Typo.body2">
                    @paginaActual / @totalPaginas
                </MudText>
            </section>
        }
    }
    </section>

</main>

<MudDialog @bind-Visible="dialogoAbierto" Options="opcionesDialogo">
    <TitleContent>
        <MudText Typo="Typo.h6">
            Pedido #@pedidoSeleccionado?.IdPedido —
            @pedidoSeleccionado?.NombreCliente
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (pedidoSeleccionado != null)
        {
            <section class="detalle-pedido">

                <header class="cabecera-detalle-pedido">
                    <MudText Class="mb-2">
                        <strong>Estado actual:</strong>
                        <MudChip T="string"
                                 Color="@(pedidoSeleccionado.NombreEstado == "Confirmado"
                                                                      ? Color.Success : Color.Error)"
                             Size="Size.Small">
                        @pedidoSeleccionado.NombreEstado
                    </MudChip>
                </MudText>

                    <MudText Class="mb-4">
                        <strong>Fecha:</strong>
                        @pedidoSeleccionado.FechaConfirm.ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </header>

                <aside class="panel-cambio-estado seccion-con-margen">
                    <MudSelect T="int"
                               Value="nuevoIdEstado"
                               ValueChanged="EstadoSeleccionado"
                               Label="Cambiar estado"
                               Variant="Variant.Outlined"
                               Class="mb-2">
                    @foreach (var estado in estados)
                        {
                            <MudSelectItem T="int" Value="@estado.IdEstado">
                                @estado.NombreEstado
                            </MudSelectItem>
                        }
                    </MudSelect>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Warning"
                               StartIcon="@Icons.Material.Filled.Update"
                               OnClick="CambiarEstado"
                               Class="mb-4">
                        Actualizar estado
                    </MudButton>
                </aside>

                <MudDivider Class="mb-3" />

                <section class="lineas-pedido">
                    <MudTable Items="pedidoSeleccionado.Detalles"
                              Elevation="0" Dense="true">
                        <HeaderContent>
                            <MudTh>Actividad</MudTh>
                            <MudTh>Cantidad</MudTh>
                            <MudTh>Precio</MudTh>
                            <MudTh>Importe</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.TituloActividad</MudTd>
                            <MudTd>@context.Cantidad</MudTd>
                            <MudTd>@context.PrecioUnitario.ToString("C")</MudTd>
                            <MudTd>@context.ImporteLinea.ToString("C")</MudTd>
                        </RowTemplate>
                    </MudTable>
                </section>

                <MudDivider Class="my-3" />

                <footer class="pie-total-pedido">
                    <MudText Typo="Typo.h6" Align="Align.Right">
                        Total: @(pedidoSeleccionado.Detalles.Sum(d => d.ImporteLinea).ToString("C"))
                    </MudText>
                </footer>

            </section>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => dialogoAbierto = false)">
            Cerrar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<PedidoDto> pedidos = new();
    private List<PedidoDto> pedidosFiltrados = new();
    private List<PedidoDto> pedidosPaginados = new();

    private List<EstadoDto> estados = new();
    private bool cargando = true;
    private bool dialogoAbierto = false;
    private PedidoDto? pedidoSeleccionado;
    private int nuevoIdEstado;
    private string textoBusqueda = string.Empty;

    private int paginaActual = 1;
    private int pedidosPorPagina = 10;
    private int totalPaginas = 0;
    private List<int> opcionesPagina = new() { 5, 10, 20, 50 };

    private DialogOptions opcionesDialogo = new()
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!EstadoAuth.EstaAutenticado)
            {
                await EstadoAuth.CargarDesdeLocalStorageAsync();
                StateHasChanged();
            }

            if (!EstadoAuth.EsAdministrador)
            {
                Navegacion.NavigateTo("/");
                return;
            }

            await CargarDatos();
            StateHasChanged();
        }
    }

    private async Task CargarDatos()
    {
        cargando = true;

        pedidos = await PedidoService.ObtenerTodosAsync(EstadoAuth.Token);
        estados = await EstadoService.ObtenerTodosAsync(EstadoAuth.Token);

        pedidosFiltrados = pedidos.ToList();
        ActualizarPaginacion();

        cargando = false;
    }

    private void ActualizarPaginacion()
    {
        totalPaginas = (int)Math.Ceiling(pedidosFiltrados.Count / (double)pedidosPorPagina);

        pedidosPaginados = pedidosFiltrados
            .Skip((paginaActual - 1) * pedidosPorPagina)
            .Take(pedidosPorPagina)
            .ToList();
    }

    private Task FiltrarPedidos()
    {
        paginaActual = 1;

        pedidosFiltrados = pedidos
            .Where(pedido =>
                string.IsNullOrWhiteSpace(textoBusqueda)
                || pedido.IdPedido.ToString().Contains(textoBusqueda)
                || pedido.NombreCliente.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
            .ToList();

        ActualizarPaginacion();

        return Task.CompletedTask;
    }

    private void IrPrimeraPagina()
    {
        paginaActual = 1;
        ActualizarPaginacion();
    }

    private void IrUltimaPagina()
    {
        paginaActual = totalPaginas;
        ActualizarPaginacion();
    }

    private void VerDetalle(PedidoDto pedido)
    {
        pedidoSeleccionado = pedido;
        nuevoIdEstado = pedido.IdEstado;
        dialogoAbierto = true;
    }

    private void EstadoSeleccionado(int idEstado)
    {
        nuevoIdEstado = idEstado;
    }

    private async Task CambiarEstado()
    {
        if (pedidoSeleccionado == null)
        {
            return;
        }

        var pedidoActualizado = await PedidoService.CambiarEstadoAsync(
            pedidoSeleccionado.IdPedido,
            nuevoIdEstado,
            EstadoAuth.Token);

        if (pedidoActualizado != null)
        {
            Snackbar.Add("Estado actualizado correctamente", Severity.Success);
            await CargarDatos();
        }
        else
        {
            Snackbar.Add("Error al actualizar el estado", Severity.Error);
        }
    }
}