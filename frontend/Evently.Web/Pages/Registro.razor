@page "/registro"
@using Evently.Web.Models
@using Evently.Web.Services
@inject AutenticacionService AutenticacionService
@inject EstadoAuthService EstadoAuth
@inject NavigationManager NavManager

<PageTitle>Registro — Evently</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">

        <MudText Typo="Typo.h5" GutterBottom="true">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" />
            Crear cuenta
        </MudText>

        <MudTextField @bind-Value="datosRegistro.Email"
                      Label="Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      AutoFocus="true"
                      AutoComplete="off"
                      Class="mb-1"
                      Error="@errorEmail" />

        @if (errorEmail)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-3">
                @mensajeErrorEmail
            </MudText>
        }

        <MudTextField @bind-Value="datosRegistro.Password"
                      Label="Contraseña"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      AutoComplete="off"
                      Class="mb-1"
                      Error="@errorPassword" />

        @if (errorPassword)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-3">
                @mensajeErrorPassword
            </MudText>
        }

        <MudTextField @bind-Value="confirmacionPassword"
                      Label="Repetir contraseña"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      AutoComplete="off"
                      Class="mb-1"
                      Error="@errorConfirmacion" />

        @if (errorConfirmacion)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-4">
                @mensajeErrorConfirmacion
            </MudText>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   OnClick="Registrarse"
                   Disabled="@(cargando || !FormularioValido)"
                   Size="Size.Large">
            @if (cargando)
            {
                <MudProgressCircular Size="Size.Small"
                                     Indeterminate="true"
                                     Class="mr-2" />
            }
            Crear cuenta
        </MudButton>

        <MudText Class="mt-4 text-center">
            ¿Ya tienes cuenta?
            <MudLink Href="/login">Inicia sesión aquí</MudLink>
        </MudText>

    </MudPaper>
</MudContainer>

@code {
    private RegistroDto datosRegistro = new();
    private string confirmacionPassword = string.Empty;
    private bool cargando = false;

    private bool errorEmail = false;
    private bool errorPassword = false;
    private bool errorConfirmacion = false;

    private string mensajeErrorEmail = string.Empty;
    private string mensajeErrorPassword = string.Empty;
    private string mensajeErrorConfirmacion = string.Empty;
    private string emailYaRegistrado = string.Empty;

    private bool FormularioValido =>
        !string.IsNullOrWhiteSpace(datosRegistro.Email)
        && !string.IsNullOrWhiteSpace(datosRegistro.Password)
        && !string.IsNullOrWhiteSpace(confirmacionPassword);

    private async Task Registrarse()
    {
        cargando = true;

        errorEmail = false;
        errorPassword = false;
        errorConfirmacion = false;

        mensajeErrorEmail = string.Empty;
        mensajeErrorPassword = string.Empty;
        mensajeErrorConfirmacion = string.Empty;

        datosRegistro.Email = datosRegistro.Email.Trim();

        int posicionArroba = datosRegistro.Email.IndexOf("@");
        int posicionPunto = datosRegistro.Email.LastIndexOf(".");

        if (string.IsNullOrWhiteSpace(datosRegistro.Email))
        {
            errorEmail = true;
            mensajeErrorEmail = "El email es obligatorio";
        }
        else if (posicionArroba == -1 || posicionPunto == -1)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }
        else if (emailYaRegistrado.ToLower() == datosRegistro.Email.ToLower())
        {
            errorEmail = true;
            mensajeErrorEmail = "Ya existe un usuario con ese email";
        }
        else if (posicionArroba == 0)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }
        else if (posicionPunto < posicionArroba)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }
        else if (posicionPunto == datosRegistro.Email.Length - 1)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }

        if (string.IsNullOrWhiteSpace(datosRegistro.Password))
        {
            errorPassword = true;
            mensajeErrorPassword = "La contraseña es obligatoria";
        }
        else if (datosRegistro.Password.Length < 8)
        {
            errorPassword = true;
            mensajeErrorPassword = "La contraseña debe tener al menos 8 caracteres";
        }

        if (string.IsNullOrWhiteSpace(confirmacionPassword))
        {
            errorConfirmacion = true;
            mensajeErrorConfirmacion = "Debes repetir la contraseña";
        }
        else if (datosRegistro.Password != confirmacionPassword)
        {
            errorConfirmacion = true;
            mensajeErrorConfirmacion = "Las contraseñas no coinciden";
        }

        if (errorEmail || errorPassword || errorConfirmacion)
        {
            cargando = false;
            StateHasChanged();
            return;
        }

        var respuesta = await AutenticacionService.RegistrarAsync(datosRegistro);

        if (respuesta == null)
        {
            emailYaRegistrado = datosRegistro.Email;

            errorEmail = true;
            mensajeErrorEmail = "Ya existe un usuario con ese email";

            cargando = false;
            StateHasChanged();
            return;
        }

        await EstadoAuth.IniciarSesionAsync(respuesta);

        cargando = false;
        NavManager.NavigateTo("/completar-perfil");
    }
}