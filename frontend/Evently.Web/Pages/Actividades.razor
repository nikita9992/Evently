@page "/actividades"
@inject ActividadService ActividadService
@inject CategoriaService CategoriaService
@inject NavigationManager Navegacion

<PageTitle>Actividades — Evently</PageTitle>

<link href="css/actividades.css" rel="stylesheet" />

<main id="pagina-actividades">

    <header class="cabecera-seccion">
        <MudText Typo="Typo.h4" GutterBottom="true">Actividades</MudText>
        <MudText Typo="Typo.subtitle1" Class="mb-4">
            Descubre todas nuestras actividades de ocio
        </MudText>
    </header>

    @* Filtros *@
    <section id="seccion-filtros" class="contenedor-filtros">
        <MudExpansionPanels Class="mb-4">
            <MudExpansionPanel Text="Filtros de búsqueda"
                               Icon="@Icons.Material.Filled.FilterList">
                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudTextField @bind-Value="filtroPorTitulo"
                                      Label="Buscar por nombre"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnKeyUp="FiltrarActividades" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="int?" @bind-Value="filtroPorCategoria"
                                   Label="Filtrar por categoría"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="int?" Value="null">
                                Todas las categorías
                            </MudSelectItem>
                            @foreach (var categoria in categorias)
                            {
                                <MudSelectItem T="int?" Value="categoria.IdCategoria">
                                    @categoria.NombreCatego
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="string" @bind-Value="filtroPorCiudad"
                                   Label="Filtrar por ciudad"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="string" Value="@("")">
                                Todas las ciudades
                            </MudSelectItem>
                            @foreach (var ciudad in ciudadesDisponibles)
                            {
                                <MudSelectItem T="string" Value="@ciudad">
                                    @ciudad
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" Class="d-flex justify-center gap-2">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="FiltrarActividades"
                                   StartIcon="@Icons.Material.Filled.FilterList">
                            Aplicar filtros
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   OnClick="LimpiarFiltros"
                                   Class="ml-2"
                                   StartIcon="@Icons.Material.Filled.Clear">
                            Limpiar filtros
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </section>

    @* Lista de actividades *@
    <section id="seccion-actividades">
        @if (cargando)
        {
            <section class="contenedor-cargando">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </section>
        }
        @* else if (!actividades.Any()) *@
        else if (!actividadesFiltradas.Any())
        {
            <MudAlert Severity="Severity.Info">
                No se encontraron actividades con los filtros seleccionados.
            </MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var actividad in actividadesPaginadas)
                {
                    <MudItem xs="12" sm="6" md="4" Class="item-actividad">
                        <MudCard Elevation="3" Class="tarjeta-actividad">

                            @* Imagen de la actividad *@
                            @if (!string.IsNullOrEmpty(actividad.ImagenPrincipal))
                            {
                                <MudCardMedia Image="@actividad.ImagenPrincipal"
                                              Height="200" />
                            }
                            else
                            {
                                <figure class="imagen-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.EventNote"
                                             Class="icono-placeholder" />
                                </figure>
                            }

                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">@actividad.Titulo</MudText>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                        @actividad.NombreCatego
                                    </MudChip>
                                </CardHeaderContent>
                            </MudCardHeader>

                            <MudCardContent Class="contenido-tarjeta">

                                @* Valoración *@
                                <section class="seccion-valoracion">
                                    @if (actividad.TotalValoraciones > 0)
                                    {
                                        var mediaCard = (int)Math.Round(actividad.MediaValoracion);
                                        <section class="estrellas-valoracion">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                int estrella = s;
                                                <span class="estrella">
                                                    @(estrella <= mediaCard ? "★" : "☆")
                                                </span>
                                            }
                                            <MudText Typo="Typo.caption" Class="ml-1">
                                                @actividad.MediaValoracion.ToString("F1")
                                                (@actividad.TotalValoraciones)
                                            </MudText>
                                        </section>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption"
                                                 Color="Color.Secondary"
                                                 Class="mb-2">
                                            Sin valoraciones aún
                                        </MudText>
                                    }
                                </section>

                                @* Descripción *@
                                <p class="descripcion-actividad">
                                    @actividad.Descripcion
                                </p>

                                @* Fecha y plazas *@
                                <footer class="pie-info-actividad">
                                    @if (actividad.FechaActiv.HasValue)
                                    {
                                        <span class="info-fecha">
                                            <MudIcon Icon="@Icons.Material.Filled.Event"
                                                     Size="Size.Small" />
                                            @actividad.FechaActiv.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }

                                    @if (actividad.PlazasDisponibles.HasValue)
                                    {
                                        @if (actividad.PlazasDisponibles == 0)
                                        {
                                            <span class="info-plazas plazas-agotadas">
                                                <MudIcon Icon="@Icons.Material.Filled.People"
                                                         Size="Size.Small" />
                                                <strong>Agotado</strong>
                                            </span>
                                        }
                                        else if (actividad.PlazasDisponibles <= 3)
                                        {
                                            <span class="info-plazas plazas-pocas">
                                                <MudIcon Icon="@Icons.Material.Filled.People"
                                                         Size="Size.Small" />
                                                ⚠ @actividad.PlazasDisponibles plazas
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="info-plazas">
                                                <MudIcon Icon="@Icons.Material.Filled.People"
                                                         Size="Size.Small" />
                                                @actividad.PlazasDisponibles plazas
                                            </span>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(actividad.Ciudad))
                                    {
                                        <span class="info-fecha">
                                            <MudIcon Icon="@Icons.Material.Filled.LocationCity"
                                                     Size="Size.Small" />
                                            @actividad.Ciudad
                                        </span>
                                    }
                                </footer>

                            </MudCardContent>

                            <MudCardActions Class="acciones-tarjeta">
                                <strong class="precio-actividad">
                                    @actividad.Precio.ToString("C")
                                </strong>
                                <MudSpacer />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => VerDetalle(actividad.IdActividad))">
                                    Ver detalle
                                </MudButton>
                            </MudCardActions>

                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            @if (totalPaginas > 0)
            {
                <section class="controlesDeParginacion">
                    <MudText Typo="Typo.body2">Mostrar:</MudText>
                    <MudSelect T="int"
                               Value="actividadesPorPagina"
                               ValueChanged="@((int v) => { actividadesPorPagina = v; paginaActual = 1; ActualizarPaginacion(); })"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Class="selectorPagina">
                        @foreach (var opcion in opcionesPagina)
                        {
                            <MudSelectItem T="int" Value="opcion">@opcion por página</MudSelectItem>
                        }
                    </MudSelect>
                    <MudPagination Count="totalPaginas"
                                   Selected="paginaActual"
                                   SelectedChanged="@((int p) => { paginaActual = p; ActualizarPaginacion(); })"
                                   Color="Color.Primary" />
                </section>
            }            
        }
    </section>

</main>

@code {
    private List<ActividadDto> actividades = new();
    private List<CategoriaDto> categorias = new();
    private List<ActividadDto> actividadesFiltradas = new();

    private string? filtroPorTitulo;
    private int? filtroPorCategoria;
    private bool cargando = true;
    private string filtroPorCiudad = string.Empty;
    private int paginaActual = 1;
    private int actividadesPorPagina = 9;
    private List<ActividadDto> todasLasActividades = new();
    private List<string> ciudadesDisponibles = new();
    private List<ActividadDto> actividadesPaginadas = new();
    private int totalPaginas = 0;
    private List<int> opcionesPagina = new() { 3, 6, 9, 21, 51 };

    private void ActualizarPaginacion()
    {
        totalPaginas = (int)Math.Ceiling(actividadesFiltradas.Count / (double)actividadesPorPagina);

        actividadesPaginadas = actividadesFiltradas
            .Skip((paginaActual - 1) * actividadesPorPagina)
            .Take(actividadesPorPagina)
            .ToList();

        ciudadesDisponibles = todasLasActividades
            .Where(a => !string.IsNullOrEmpty(a.Ciudad))
            .Select(a => a.Ciudad ?? string.Empty)
            .Where(c => c != string.Empty)
            .Distinct()
            .OrderBy(c => c)
            .ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        categorias  = await CategoriaService.ObtenerTodasAsync();
        actividades = await ActividadService.ObtenerTodasAsync();
        todasLasActividades = actividades.ToList();
        actividadesFiltradas = actividades.ToList();


        cargando    = false;
        ActualizarPaginacion();
    }

    /* Aplicar filtros */
    private async Task FiltrarActividades()
    {
        cargando = true;
        paginaActual = 1;

        actividades = await ActividadService.ObtenerTodasAsync(
            filtroPorCategoria,
            filtroPorTitulo,
            filtroPorCiudad);        

        actividadesFiltradas = actividades.ToList();

        ActualizarPaginacion();
        cargando = false;
    }
        
    /* Limpiar filtros */
    private async Task LimpiarFiltros()
    {
        filtroPorTitulo = string.Empty;
        filtroPorCategoria = null;
        filtroPorCiudad = string.Empty;

        await FiltrarActividades();
    }

    /* Ir al detalle de la actividad */
    private void VerDetalle(int id)
    {
        Navegacion.NavigateTo($"/actividades/{id}");
    }
}
