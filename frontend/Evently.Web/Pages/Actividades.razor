@page "/actividades"
@inject ActividadService ActividadService
@inject CategoriaService CategoriaService
@inject NavigationManager Navegacion

<PageTitle>Actividades — Evently</PageTitle>

<link href="css/actividades.css" rel="stylesheet" />

<main id="pagina-actividades">

    <header class="cabecera-seccion">
        <MudText Typo="Typo.h4" GutterBottom="true">Actividades</MudText>
        <MudText Typo="Typo.subtitle1" Class="mb-4">
            Descubre todas nuestras actividades de ocio
        </MudText>
    </header>

    <!-- Filtros -->
    <section id="seccion-filtros" class="contenedor-filtros">
        <MudExpansionPanels Class="mb-4">
            <MudExpansionPanel Text="Filtros de búsqueda"
                               Icon="@Icons.Material.Filled.FilterList">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="filtroPorTitulo"
                                      Label="Buscar por nombre"
                                      Variant="Variant.Outlined"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true"
                                      OnKeyUp="FiltrarActividades" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="int?" @bind-Value="filtroPorCategoria"
                                   Label="Filtrar por categoría"
                                   Variant="Variant.Outlined"
                                   AnchorOrigin="Origin.BottomCenter">
                            <MudSelectItem T="int?" Value="null">
                                Todas las categorías
                            </MudSelectItem>
                            @foreach (var categoria in categorias)
                            {
                                <MudSelectItem T="int?" Value="categoria.IdCategoria">
                                    @categoria.NombreCatego
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="FiltrarActividades"
                                   StartIcon="@Icons.Material.Filled.FilterList">
                            Aplicar filtros
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   OnClick="LimpiarFiltros"
                                   Class="ml-2"
                                   StartIcon="@Icons.Material.Filled.Clear">
                            Limpiar
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </section>

    <!-- Lista de actividades -->
    <section id="seccion-actividades">
        @if (cargando)
        {
            <div class="contenedor-cargando">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (!actividades.Any())
        {
            <MudAlert Severity="Severity.Info">
                No se encontraron actividades con los filtros seleccionados.
            </MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var actividad in actividades)
                {
                    <MudItem xs="12" sm="6" md="4" Class="item-actividad">
                        <MudCard Elevation="3" Class="tarjeta-actividad">

                            <!-- Imagen de la actividad -->
                            @if (!string.IsNullOrEmpty(actividad.ImagenPrincipal))
                            {
                                <MudCardMedia Image="@actividad.ImagenPrincipal"
                                              Height="200" />
                            }
                            else
                            {
                                <figure class="imagen-placeholder">
                                    <MudIcon Icon="@Icons.Material.Filled.EventNote"
                                             Class="icono-placeholder" />
                                </figure>
                            }

                            <MudCardHeader>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">@actividad.Titulo</MudText>
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                        @actividad.NombreCatego
                                    </MudChip>
                                </CardHeaderContent>
                            </MudCardHeader>

                            <MudCardContent Class="contenido-tarjeta">

                                <!-- Valoración -->
                                <section class="seccion-valoracion">
                                    @if (actividad.TotalValoraciones > 0)
                                    {
                                        var mediaCard = (int)Math.Round(actividad.MediaValoracion);
                                        <div class="estrellas-valoracion">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                int estrella = s;
                                                <span class="estrella">
                                                    @(estrella <= mediaCard ? "★" : "☆")
                                                </span>
                                            }
                                            <MudText Typo="Typo.caption" Class="ml-1">
                                                @actividad.MediaValoracion.ToString("F1")
                                                (@actividad.TotalValoraciones)
                                            </MudText>
                                        </div>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.caption"
                                                 Color="Color.Secondary"
                                                 Class="mb-2">
                                            Sin valoraciones aún
                                        </MudText>
                                    }
                                </section>

                                <!-- Descripción -->
                                <p class="descripcion-actividad">
                                    @actividad.Descripcion
                                </p>

                                <!-- Fecha y plazas -->
                                <footer class="pie-info-actividad">
                                    @if (actividad.FechaActiv.HasValue)
                                    {
                                        <span class="info-fecha">
                                            <MudIcon Icon="@Icons.Material.Filled.Event"
                                                     Size="Size.Small" />
                                            @actividad.FechaActiv.Value.ToString("dd/MM/yyyy")
                                        </span>
                                    }

                                    @if (actividad.PlazasDisponibles.HasValue)
                                    {
                                        @if (actividad.PlazasDisponibles == 0)
                                        {
                                            <span class="info-plazas plazas-agotadas">
                                                <MudIcon Icon="@Icons.Material.Filled.People"
                                                         Size="Size.Small" />
                                                <strong>Agotado</strong>
                                            </span>
                                        }
                                        else if (actividad.PlazasDisponibles <= 3)
                                        {
                                            <span class="info-plazas plazas-pocas">
                                                <MudIcon Icon="@Icons.Material.Filled.People"
                                                         Size="Size.Small" />
                                                ⚠ @actividad.PlazasDisponibles plazas
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="info-plazas">
                                                <MudIcon Icon="@Icons.Material.Filled.People"
                                                         Size="Size.Small" />
                                                @actividad.PlazasDisponibles plazas
                                            </span>
                                        }
                                    }
                                </footer>

                            </MudCardContent>

                            <MudCardActions Class="acciones-tarjeta">
                                <strong class="precio-actividad">
                                    @actividad.Precio.ToString("C")
                                </strong>
                                <MudSpacer />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => VerDetalle(actividad.IdActividad))">
                                    Ver detalle
                                </MudButton>
                            </MudCardActions>

                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
    </section>

</main>

@code {
    private List<ActividadDto> actividades = new();
    private List<CategoriaDto> categorias = new();
    private string? filtroPorTitulo;
    private int? filtroPorCategoria;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        categorias  = await CategoriaService.ObtenerTodasAsync();
        actividades = await ActividadService.ObtenerTodasAsync();
        cargando    = false;
    }

    /* Aplicar filtros */
    private async Task FiltrarActividades()
    {
        cargando    = true;
        actividades = await ActividadService.ObtenerTodasAsync(
            filtroPorCategoria,
            filtroPorTitulo);
        cargando = false;
    }

    /* Limpiar filtros */
    private async Task LimpiarFiltros()
    {
        filtroPorTitulo    = null;
        filtroPorCategoria = null;
        await FiltrarActividades();
    }

    /* Ir al detalle de la actividad */
    private void VerDetalle(int id)
    {
        Navegacion.NavigateTo($"/actividades/{id}");
    }
}
