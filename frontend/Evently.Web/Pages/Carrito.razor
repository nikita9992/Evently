@page "/carrito"
@using Evently.Web.Models
@using Evently.Web.Services
@inject PedidoService PedidoService
@inject ClienteService ClienteService
@inject ActividadService ActividadService
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject EstadoAuthService EstadoAuth
@inject ISnackbar Snackbar

<PageTitle>Mi carrito — Evently</PageTitle>

@if (pedidoConfirmado)
{
    <section class="centrado-flex estado-carrito">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
             Class="mb-4 icono-estado-carrito icono-pedido-confirmado" />   
        <MudText Typo="Typo.h4" GutterBottom="true">¡Pedido confirmado!</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Gracias por tu reserva. Recibirás los detalles pronto.
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="/mispedidos"
                   StartIcon="@Icons.Material.Filled.Receipt"
                   Size="Size.Large">
            Ver mis pedidos
        </MudButton>
    </section>
}
else if (cargando)
{
    <section class="centrado-flex estado-carrito-cargando">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </section>
}
else if (elementosCarrito.Count == 0)
{
    <section class="centrado-flex estado-carrito">
        <MudIcon Icon="@Icons.Material.Filled.ShoppingCartCheckout"
             Class="mb-4 icono-estado-carrito icono-carrito-vacio" />   
        <MudText Typo="Typo.h5" GutterBottom="true">Tu carrito está vacío</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            Explora nuestras actividades y añade las que más te gusten.
        </MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="/actividades"
                   StartIcon="@Icons.Material.Filled.EventNote"
                   Size="Size.Large">
            Ver actividades
        </MudButton>
    </section>
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true" Class="mb-5">
        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Class="mr-2" />
        Mi carrito
        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Class="ml-2">
            @elementosCarrito.Count @(elementosCarrito.Count == 1 ? "actividad" : "actividades")
        </MudChip>
    </MudText>

    <MudGrid>
        @* Lista de productos *@
        <MudItem xs="12" md="8">
            @foreach (var item in elementosCarrito)
            {
                var actividad = actividadesInfo.GetValueOrDefault(item.IdActividad);
                var stockLimitado = actividad?.PlazasDisponibles.HasValue == true
                                    && item.Cantidad >= actividad.PlazasDisponibles;
                <MudPaper Elevation="2" Class="mb-4 tarjeta-carrito">
                    <article class="contenido-item-carrito">
                        @* Imagen *@
                        @if (!string.IsNullOrEmpty(actividad?.ImagenPrincipal))
                        {
                            <img src="@actividad.ImagenPrincipal"
                                 alt="@item.Titulo"
                                 class="imagen-carrito" />
                        }
                        else
                        {
                            <figure class="centrado-flex fondo-gradiente-evently imagen-carrito-placeholder">
                                <MudIcon Icon="@Icons.Material.Filled.EventNote"
                                         Class="icono-placeholder" />
                            </figure>
                        }

                        @* Contenido *@
                        <section class="detalle-item-carrito">
                            <section>
                                <MudText Typo="Typo.h6">@item.Titulo</MudText>
                                @if (actividad?.FechaActiv.HasValue == true)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        <MudIcon Icon="@Icons.Material.Filled.Event"
                                                 Size="Size.Small" Class="mr-1" />
                                        @actividad.FechaActiv.Value.ToString("dd/MM/yyyy HH:mm")
                                    </MudText>
                                }
                                <MudText Typo="Typo.body2" Color="Color.Primary" Class="mt-1">
                                    @item.Precio.ToString("C") por persona
                                </MudText>
                            </section>

                            <section class="acciones-item-carrito">
                                @* controles cantidad *@
                                <section class="controles-cantidad-carrito">
                                    <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@(item.Cantidad <= 1)"
                                                   OnClick="@(() => CambiarCantidad(item, -1))" />
                                    <MudText Typo="Typo.h6" Class="cantidad-carrito">
                                        @item.Cantidad
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   Color="Color.Primary"
                                                   Disabled="@stockLimitado"
                                                   OnClick="@(() => CambiarCantidad(item, +1))" />
                                    @if (actividad?.PlazasDisponibles.HasValue == true)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            máx. @actividad.PlazasDisponibles
                                        </MudText>
                                    }
                                </section>

                                @* Eliminar *@
                                <section class="precio-accion-carrito">
                                    <MudText Typo="Typo.h6" Color="Color.Primary">
                                        @item.ImporteLinea.ToString("C")
                                    </MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => EliminarDelCarrito(item))" />
                                </section>
                            </section>
                        </section>
                    </article>
                    @if (actividad?.PlazasDisponibles.HasValue == true && item.Cantidad > actividad.PlazasDisponibles)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mx-3 mb-3">
                            Solo quedan @actividad.PlazasDisponibles plaza(s) disponibles, pero tienes @item.Cantidad en el carrito.
                            Reduce la cantidad para poder confirmar el pedido.
                        </MudAlert>
                    }
                </MudPaper>
            }
        </MudItem>

         @* Panel resumen del pedido  *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="3" Class="pa-4 panel-resumen-carrito">
                <MudText Typo="Typo.h6" GutterBottom="true">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-1" />
                    Resumen del pedido
                </MudText>
                <MudDivider Class="mb-3" />

                @foreach (var item in elementosCarrito)
                {
                    <section class="fila-resumen-carrito">
                        <MudText Typo="Typo.body2" Class="titulo-resumen-carrito">
                            @item.Titulo ×@item.Cantidad
                        </MudText>
                        <MudText Typo="Typo.body2">
                            @item.ImporteLinea.ToString("C")
                        </MudText>
                    </section>
                }

                <MudDivider Class="my-3" />

                <section class="fila-subtotal-carrito">
                    <MudText Typo="Typo.body1">Subtotal</MudText>
                    <MudText Typo="Typo.body1">
                        @elementosCarrito.Sum(e => e.ImporteLinea).ToString("C")
                    </MudText>
                </section>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                    Impuestos incluidos
                </MudText>

                <MudDivider Class="mb-3" />

                <section class="fila-total-carrito">
                    <MudText Typo="Typo.h6">Total</MudText>
                    <MudText Typo="Typo.h6" Color="Color.Primary">
                        @elementosCarrito.Sum(e => e.ImporteLinea).ToString("C")
                    </MudText>
                </section>

                @if (!EstadoAuth.EstaAutenticado)
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true">
                        Inicia sesión para confirmar tu pedido.
                    </MudAlert>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Href="/login"
                               StartIcon="@Icons.Material.Filled.Login">
                        Iniciar sesión
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               OnClick="ConfirmarPedido"
                               Disabled="estaConfirmando"
                               StartIcon="@Icons.Material.Filled.CheckCircle">
                        @if (estaConfirmando)
                        {
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate="true"
                                                 Class="mr-2" />
                        }
                        Confirmar pedido
                    </MudButton>
                }

                <MudButton Variant="Variant.Text"
                           Color="Color.Secondary"
                           FullWidth="true"
                           Class="mt-2"
                           Href="/actividades"
                           StartIcon="@Icons.Material.Filled.ArrowBack">
                    Seguir comprando
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private List<ItemCarrito> elementosCarrito = new();
    private Dictionary<int, ActividadDto> actividadesInfo = new();
    private int idCliente = 0;
    private bool estaConfirmando = false;
    private bool pedidoConfirmado = false;
    private bool cargando = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!EstadoAuth.EstaAutenticado)
                await EstadoAuth.CargarDesdeLocalStorageAsync();

            await CargarCarrito();
            await CargarInfoActividades();

            cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarCarrito()
    {
        try
        {
            var json = await JS.InvokeAsync<string>("obtenerCarrito", EstadoAuth.IdUsuario);
            if (!string.IsNullOrEmpty(json))
                elementosCarrito = System.Text.Json.JsonSerializer
                    .Deserialize<List<ItemCarrito>>(json) ?? new();
        }
        catch
        {
            elementosCarrito = new();
        }
    }

    private async Task CargarInfoActividades()
    {
        var itemsAEliminar = new List<ItemCarrito>();

        foreach (var item in elementosCarrito)
        {
            if (!actividadesInfo.ContainsKey(item.IdActividad))
            {
                try
                {
                    var actividad = await ActividadService.ObtenerPorIdAsync(item.IdActividad);
                    if (actividad != null)
                        actividadesInfo[item.IdActividad] = actividad;
                    else
                        itemsAEliminar.Add(item);
                }
                catch
                {
                    itemsAEliminar.Add(item);
                }
            }
        }

        if (itemsAEliminar.Any())
        {
            foreach (var item in itemsAEliminar)
                elementosCarrito.Remove(item);

            await GuardarCarrito();
            Snackbar.Add("Algunas actividades ya no están disponibles y se han eliminado del carrito.", Severity.Warning);
        }
    }

    private async Task CambiarCantidad(ItemCarrito item, int delta)
    {
        var nuevaCantidad = item.Cantidad + delta;

        if (nuevaCantidad < 1)
            return;

        var actividad = actividadesInfo.GetValueOrDefault(item.IdActividad);
        if (actividad?.PlazasDisponibles.HasValue == true
            && nuevaCantidad > actividad.PlazasDisponibles)
        {
            Snackbar.Add(
                $"Solo quedan {actividad.PlazasDisponibles} plaza(s) para \"{item.Titulo}\"",
                Severity.Warning);
            return;
        }

        item.Cantidad = nuevaCantidad;
        await GuardarCarrito();
    }

    private async Task EliminarDelCarrito(ItemCarrito elemento)
    {
        elementosCarrito.Remove(elemento);
        await GuardarCarrito();
    }

    private async Task GuardarCarrito()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(elementosCarrito);
        await JS.InvokeVoidAsync("guardarCarrito", json, EstadoAuth.IdUsuario);
    }

    private async Task<bool> ValidarStockCarrito()
    {
        var hayProblemas = false;

        foreach (var item in elementosCarrito)
        {
            var actividad = await ActividadService.ObtenerPorIdAsync(item.IdActividad);

            if (actividad == null)
            {
                Snackbar.Add(
                    $"La actividad \"{item.Titulo}\" ya no está disponible y ha sido eliminada del carrito.",
                    Severity.Error);
                elementosCarrito.Remove(item);
                await GuardarCarrito();
                hayProblemas = true;
                break;
            }

            actividadesInfo[item.IdActividad] = actividad; 

            if (actividad.PlazasDisponibles.HasValue && item.Cantidad > actividad.PlazasDisponibles.Value)
            {
                if (actividad.PlazasDisponibles.Value == 0)
                {
                    Snackbar.Add(
                        $"Ya no quedan plazas para \"{item.Titulo}\". Elimínala del carrito para continuar.",
                        Severity.Error);
                }
                else
                {
                    Snackbar.Add(
                        $"Solo quedan {actividad.PlazasDisponibles.Value} plaza(s) para \"{item.Titulo}\" " +
                        $"pero tienes {item.Cantidad} en el carrito. Ajusta la cantidad para continuar.",
                        Severity.Warning);
                }
                hayProblemas = true;
            }
        }

        return !hayProblemas;
    }

    private async Task ConfirmarPedido()
    {
        if (!EstadoAuth.EstaAutenticado)
        {
            NavManager.NavigateTo("/login");
            return;
        }

        var cliente = await ClienteService.ObtenerPorUsuarioAsync(EstadoAuth.IdUsuario, EstadoAuth.Token);

        if (cliente == null
            || string.IsNullOrWhiteSpace(cliente.Nombre)
            || string.IsNullOrWhiteSpace(cliente.Apellidos)
            || string.IsNullOrWhiteSpace(cliente.Telefono))
        {
            NavManager.NavigateTo("/completar-perfil");
            return;
        }

        idCliente = cliente.IdCliente;
        estaConfirmando = true;

        var stockOk = await ValidarStockCarrito();
        if (!stockOk)
        {
            estaConfirmando = false;
            StateHasChanged();
            return;
        }

        var dto = new ConfirmarPedidoDto
        {
            IdCliente = idCliente,
            Actividades = elementosCarrito.Select(e => new ItemCarritoDto
            {
                IdActividad = e.IdActividad,
                Cantidad = e.Cantidad,
                PrecioUnitario = e.Precio
            }).ToList()
        };

        var resultado = await PedidoService.ConfirmarPedidoAsync(dto, EstadoAuth.Token);

        if (resultado == null)
        {
            Snackbar.Add(
                "No se ha podido confirmar el pedido. Inténtalo de nuevo.",
                Severity.Error);
        }
        else
        {
            elementosCarrito.Clear();
            await JS.InvokeVoidAsync("limpiarCarrito", EstadoAuth.IdUsuario);
            pedidoConfirmado = true;
        }

        estaConfirmando = false;
    }
}
