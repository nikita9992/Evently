@page "/login"
@using Evently.Web.Models
@using Evently.Web.Services
@inject AutenticacionService AutenticacionService
@inject NavigationManager NavManager
@inject EstadoAuthService EstadoAuth

<PageTitle>Iniciar sesión — Evently</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="3" Class="pa-6">

        <MudText Typo="Typo.h5" GutterBottom="true">Iniciar sesión</MudText>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@mensajeError</MudAlert>
        }

        <MudTextField @bind-Value="datosLogin.Email"
                      Label="Email"
                      InputType="InputType.Email"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      AutoFocus="true"
                      AutoComplete="off"
                      Class="mb-1"
                      Error="@errorEmail" />

        @if (errorEmail)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-3">
                @mensajeErrorEmail
            </MudText>
        }

        <MudTextField @bind-Value="datosLogin.Password"
                      Label="Contraseña"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      AutoComplete="off"
                      Class="mb-1"
                      Error="@errorPassword" />

        @if (errorPassword)
        {
            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-4">
                @mensajeErrorPassword
            </MudText>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   FullWidth="true"
                   OnClick="IniciarSesion"
                   Disabled="cargando">
            @if (cargando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Entrar
        </MudButton>

        <MudText Class="mt-4 text-center">
            ¿No tienes cuenta?
            <MudLink Href="/registro">Regístrate aquí</MudLink>
        </MudText>

    </MudPaper>
</MudContainer>

@code {
    private LoginDto datosLogin = new();
    private string mensajeError = string.Empty;
    private bool cargando = false;

    private bool errorEmail = false;
    private bool errorPassword = false;

    private string mensajeErrorEmail = string.Empty;
    private string mensajeErrorPassword = string.Empty;

    private async Task IniciarSesion()
    {
        cargando = true;

        mensajeError = string.Empty;
        errorEmail = false;
        errorPassword = false;
        mensajeErrorEmail = string.Empty;
        mensajeErrorPassword = string.Empty;

        datosLogin.Email = datosLogin.Email.Trim();

        int posicionArroba = datosLogin.Email.IndexOf("@");
        int posicionPunto = datosLogin.Email.LastIndexOf(".");

        if (string.IsNullOrWhiteSpace(datosLogin.Email))
        {
            errorEmail = true;
            mensajeErrorEmail = "El email es obligatorio";
        }
        else if (posicionArroba == -1 || posicionPunto == -1)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }
        else if (posicionArroba == 0)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }
        else if (posicionPunto < posicionArroba)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }
        else if (posicionPunto == datosLogin.Email.Length - 1)
        {
            errorEmail = true;
            mensajeErrorEmail = "El email no tiene un formato válido";
        }

        if (string.IsNullOrWhiteSpace(datosLogin.Password))
        {
            errorPassword = true;
            mensajeErrorPassword = "La contraseña es obligatoria";
        }
        else if (datosLogin.Password.Length < 8)
        {
            errorPassword = true;
            mensajeErrorPassword = "La contraseña debe tener al menos 8 caracteres";
        }

        if (errorEmail || errorPassword)
        {
            cargando = false;
            StateHasChanged();
            return;
        }

        var respuesta = await AutenticacionService.LoginAsync(datosLogin);

        if (respuesta == null)
        {
            mensajeError = "No se ha podido iniciar sesión. Comprueba el email y la contraseña.";

            cargando = false;
            StateHasChanged();
            return;
        }

        await EstadoAuth.IniciarSesionAsync(respuesta);

        if (respuesta.Rol == "administrador")
        {
            NavManager.NavigateTo("/admin/dashboard");
        }
        else
        {
            NavManager.NavigateTo("/");
        }

        cargando = false;
    }
}