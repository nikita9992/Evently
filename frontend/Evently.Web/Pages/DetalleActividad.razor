@page "/actividades/{Id:int}"
@inject ActividadService ActividadService
@inject ComentarioService ComentarioService
@inject ValoracionService ValoracionService
@inject NavigationManager Navegacion
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject EstadoAuthService EstadoAuth
@inject ClienteService ClienteService

<PageTitle>Detalle — Evently</PageTitle>

@if (cargando)
{
    <section class="contenedor-cargando">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </section>
}
else if (actividad == null)
{
    <MudAlert Severity="Severity.Error">
        Actividad no encontrada.
    </MudAlert>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               Class="mt-4"
               OnClick="@(() => Navegacion.NavigateTo("/actividades"))">
        Volver al catálogo
    </MudButton>
}
else
{
    <MudBreadcrumbs Items="migasDePan" Class="mb-4" />

    <main id="pagina-detalle">

        <MudGrid>

            <!-- Columna izquierda: info de la actividad -->
            <MudItem xs="12" md="8">
                <article class="articulo-actividad">

                    <header class="cabecera-articulo">
                        <MudText Typo="Typo.h4" GutterBottom="true">
                            @actividad.Titulo
                        </MudText>
                    </header>

                    <!-- Galería de imágenes -->
                    @if (actividad.Imagenes.Any())
                    {
                        <figure class="galeria-imagenes">
                            <img src="@actividad.Imagenes[imagenActual]"
                                 alt="@actividad.Titulo"
                                 class="imagen-principal" />

                            @if (actividad.Imagenes.Count > 1)
                            {
                                <nav class="miniaturas-galeria">
                                    @for (int i = 0; i < actividad.Imagenes.Count; i++)
                                    {
                                        var indice = i;
                                        <img src="@actividad.Imagenes[indice]"
                                             alt="Imagen @(indice + 1)"
                                             class="@(imagenActual == indice ? "miniatura miniatura-activa" : "miniatura")"
                                             @onclick="@(() => imagenActual = indice)" />
                                    }
                                </nav>
                            }
                        </figure>
                    }
                    else
                    {
                        <figure class="imagen-placeholder imagen-placeholder-grande">
                            <MudIcon Icon="@Icons.Material.Filled.EventNote"
                                     class="icono-placeholder icono-placeholder-grande" />
                        </figure>
                    }

                    <!-- Categoría -->
                    <MudChip T="string" Color="Color.Primary" Class="mb-3">
                        @actividad.NombreCatego
                    </MudChip>

                    <!-- Descripción -->
                    <p class="descripcion-detalle">
                        @actividad.Descripcion
                    </p>

                    <MudDivider Class="mb-4" />

                    <!-- Fecha y plazas -->
                    <section class="seccion-info-detalle">
                        <MudGrid>
                            @if (actividad.FechaActiv.HasValue)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudText Typo="Typo.caption">Fecha</MudText>
                                        <MudText Typo="Typo.body1">
                                            <MudIcon Icon="@Icons.Material.Filled.Event"
                                                     Size="Size.Small" />
                                            @actividad.FechaActiv.Value.ToString("dd/MM/yyyy HH:mm")
                                        </MudText>
                                    </MudPaper>
                                </MudItem>
                            }
                            @if (actividad.CupoMaximo.HasValue)
                            {
                                <MudItem xs="12" sm="6">
                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudText Typo="Typo.caption">Plazas disponibles</MudText>
                                        <MudText Typo="Typo.body1"
                                                 Class="@(actividad.PlazasDisponibles <= 3 ? "texto-peligro" : "")">
                                            <MudIcon Icon="@Icons.Material.Filled.People"
                                                     Size="Size.Small" />
                                            @actividad.PlazasDisponibles / @actividad.CupoMaximo plazas
                                        </MudText>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    </section>

                </article>
            </MudItem>

            <!-- Columna derecha: panel de compra -->
            <MudItem xs="12" md="4">
                <aside class="panel-compra">
                    <MudPaper Class="pa-4" Elevation="3">

                        <!-- Valoración media -->
                        @if (resumenValoracion.TotalValoraciones > 0)
                        {
                            var mediaCompra = (int)Math.Round(resumenValoracion.Media);
                            <section class="estrellas-valoracion">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    int estrella = s;
                                    <span class="estrella estrella-pequena">
                                        @(estrella <= mediaCompra ? "★" : "☆")
                                    </span>
                                }
                                <MudText Typo="Typo.body2">
                                    @resumenValoracion.Media
                                    (@resumenValoracion.TotalValoraciones)
                                </MudText>
                            </section>
                        }

                        <MudText Typo="Typo.h4" Color="Color.Primary" GutterBottom="true">
                            @actividad.Precio.ToString("C")
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mb-4">por persona</MudText>

                        <MudDivider Class="mb-4" />

                        <!-- Alertas de plazas -->
                        @if (actividad.PlazasDisponibles == 0)
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">
                                No quedan plazas disponibles
                            </MudAlert>
                        }
                        else if (actividad.PlazasDisponibles <= 3)
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-3">
                                Solo quedan @actividad.PlazasDisponibles plazas
                            </MudAlert>
                        }

                        <MudText Typo="Typo.subtitle2" Class="mb-2">Cantidad</MudText>
                        <MudNumericField @bind-Value="cantidad"
                                         Label="Cantidad"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="@(actividad.PlazasDisponibles ?? actividad.CupoMaximo ?? 10)"
                                         Class="mb-4" />

                        <MudText Typo="Typo.subtitle1" Class="mb-4">
                            Total: <strong class="texto-precio">
                                @((actividad.Precio * cantidad).ToString("C"))
                            </strong>
                        </MudText>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   FullWidth="true"
                                   Size="Size.Large"
                                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                                   OnClick="AnadirAlCarrito"
                                   Disabled="@(actividad.PlazasDisponibles == 0)">
                            @(actividad.PlazasDisponibles == 0
                                ? "Sin plazas disponibles"
                                : "Añadir al carrito")
                        </MudButton>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   FullWidth="true"
                                   Class="mt-2"
                                   OnClick="@(() => Navegacion.NavigateTo("/actividades"))">
                            Volver al catálogo
                        </MudButton>

                    </MudPaper>
                </aside>
            </MudItem>
        </MudGrid>

        <MudDivider Class="my-6" />

        <!-- Sección valoraciones y comentarios -->
        <section id="seccion-resenas">
            <MudGrid>

                <!-- Resumen de valoraciones -->
                <MudItem xs="12">
                    <header class="cabecera-seccion">
                        <MudText Typo="Typo.h5" GutterBottom="true">
                            Valoraciones y comentarios
                        </MudText>
                    </header>

                    @if (resumenValoracion.TotalValoraciones > 0)
                    {
                        var mediaGrande = (int)Math.Round(resumenValoracion.Media);
                        <main class="resumen-valoracion">
                            <MudText Typo="Typo.h3" Color="Color.Warning">
                                @resumenValoracion.Media
                            </MudText>
                            <aside>
                                <section class="estrellas-valoracion">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        int estrella = s;
                                        <span class="estrella estrella-grande">
                                            @(estrella <= mediaGrande ? "★" : "☆")
                                        </span>
                                    }
                                </section>
                                <MudText Typo="Typo.body2">
                                    @resumenValoracion.TotalValoraciones valoraciones
                                </MudText>
                            </aside>
                        </main>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            Esta actividad aún no tiene valoraciones.
                        </MudAlert>
                    }
                </MudItem>

                <!-- Selector de valoración (solo si compró) -->
                @if (puedeValorar)
                {
                    <MudItem xs="12">
                        <MudPaper Elevation="2" Class="pa-4 mb-4">
                            <MudText Typo="Typo.subtitle1" GutterBottom="true">
                                Tu valoración
                            </MudText>
                            <section class="selector-estrellas">
                                @for (int s = 1; s <= 5; s++)
                                {
                                    int numEstrella = s;
                                    bool activa = numEstrella <= (estrellaHover > 0
                                        ? estrellaHover : estrellaSeleccionada);
                                    <span class="@(activa ? "estrella-selector estrella-selector-activa" : "estrella-selector")"
                                          @onclick="@(() => SeleccionarEstrella(numEstrella))"
                                          @onmouseenter="@(() => estrellaHover = numEstrella)"
                                          @onmouseleave="@(() => estrellaHover = 0)">
                                        @(activa ? "★" : "☆")
                                    </span>
                                }
                            </section>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Warning"
                                       OnClick="EnviarValoracion"
                                       Disabled="estrellaSeleccionada == 0"
                                       StartIcon="@Icons.Material.Filled.Star">
                                @(resumenValoracion.ValoracionUsuario.HasValue
                                    ? "Actualizar valoración"
                                    : "Enviar valoración")
                            </MudButton>
                        </MudPaper>
                    </MudItem>
                }

                <!-- Formulario de comentario -->
                <MudItem xs="12">
                    @if (EstadoAuth.EstaAutenticado)
                    {
                        @if (tienePerfilCompleto)
                        {
                            <MudPaper Elevation="2" Class="pa-4 mb-4">
                                <MudText Typo="Typo.subtitle1" GutterBottom="true">
                                    Escribe un comentario
                                </MudText>
                                <MudTextField @bind-Value="nuevoComentario"
                                             Label="Tu comentario (mínimo 10 caracteres)"
                                             Variant="Variant.Outlined"
                                             Lines="3"
                                             MaxLength="1000"
                                             Counter="1000"
                                             Immediate="true"
                                             Class="mb-3" />
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="EnviarComentario"
                                           Disabled="nuevoComentario.Length < 10"
                                           StartIcon="@Icons.Material.Filled.Send">
                                    Enviar comentario
                                </MudButton>
                            </MudPaper>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Class="mb-4">
                                Debes completar tu perfil para poder comentar.
                                <MudLink Href="/perfil"> Ir a mi perfil</MudLink>
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            <MudLink Href="/login">Inicia sesión</MudLink>
                            para dejar un comentario.
                        </MudAlert>
                    }
                </MudItem>

                <!-- Lista de comentarios -->
                <MudItem xs="12">
                    <MudText Typo="Typo.h6" GutterBottom="true">
                        Comentarios (@comentarios.Count)
                    </MudText>

                    @if (!comentarios.Any())
                    {
                        <MudAlert Severity="Severity.Info">
                            Aún no hay comentarios.
                        </MudAlert>
                    }
                    else
                    {
                        <ul class="lista-comentarios">
                            @foreach (var comentario in comentarios)
                            {
                                <li class="item-comentario">
                                    <MudPaper Elevation="1" Class="pa-3 mb-3">
                                        <header class="cabecera-comentario">
                                            <MudText Typo="Typo.subtitle2">
                                                <MudIcon Icon="@Icons.Material.Filled.Person"
                                                         Size="Size.Small" Class="mr-1" />
                                                @comentario.NombreUsuario
                                            </MudText>
                                            <aside class="acciones-comentario">
                                                <MudText Typo="Typo.caption"
                                                         Color="Color.Secondary">
                                                    @comentario.FechaCreacion.ToString("dd/MM/yyyy")
                                                </MudText>
                                                @if (EstadoAuth.EstaAutenticado &&
                                                     (comentario.IdUsuario == EstadoAuth.IdUsuario
                                                      || EstadoAuth.EsAdministrador))
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => EliminarComentario(comentario))" />
                                                }
                                            </aside>
                                        </header>
                                        <p class="texto-comentario">
                                            @comentario.Texto
                                        </p>
                                    </MudPaper>
                                </li>
                            }
                        </ul>
                    }
                </MudItem>

            </MudGrid>
        </section>

    </main>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private int MediaRedondeada =>
        resumenValoracion.TotalValoraciones > 0
            ? (int)Math.Round(resumenValoracion.Media)
            : 0;

    private ActividadDto? actividad;
    private int cantidad = 1;
    private bool cargando = true;
    private int imagenActual = 0;
    private List<BreadcrumbItem> migasDePan = new();
    private List<ComentarioDto> comentarios = new();
    private ResumenValoracionDto resumenValoracion = new();
    private bool puedeValorar = false;
    private string nuevoComentario = string.Empty;
    private int estrellaSeleccionada = 0;
    private int estrellaHover = 0;
    private bool tienePerfilCompleto = false;

    protected override async Task OnInitializedAsync()
    {
        actividad = await ActividadService.ObtenerPorIdAsync(Id);

        migasDePan = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Inicio", href: "/"),
            new BreadcrumbItem("Actividades", href: "/actividades"),
            new BreadcrumbItem(actividad?.Titulo ?? "Detalle", href: null, disabled: true)
        };

        await CargarComentariosYValoraciones();

        cargando = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !EstadoAuth.EstaAutenticado)
        {
            await EstadoAuth.CargarDesdeLocalStorageAsync();

            if (EstadoAuth.EstaAutenticado)
            {
                puedeValorar = await ValoracionService.PuedeValorarAsync(
                    Id, EstadoAuth.Token);

                var cliente = await ClienteService.ObtenerPorUsuarioAsync(
                    EstadoAuth.IdUsuario, EstadoAuth.Token);

                tienePerfilCompleto = cliente != null
                    && !string.IsNullOrEmpty(cliente.Nombre)
                    && !string.IsNullOrEmpty(cliente.Apellidos);

                if (resumenValoracion.ValoracionUsuario.HasValue)
                    estrellaSeleccionada = resumenValoracion.ValoracionUsuario.Value;

                StateHasChanged();
            }
        }
    }

    private async Task CargarComentariosYValoraciones()
    {
        comentarios       = await ComentarioService.ObtenerPorActividadAsync(Id);
        resumenValoracion = await ValoracionService.ObtenerResumenAsync(Id);

        if (resumenValoracion.ValoracionUsuario.HasValue)
            estrellaSeleccionada = resumenValoracion.ValoracionUsuario.Value;
        else
            estrellaSeleccionada = 0;

        if (EstadoAuth.EstaAutenticado)
        {
            puedeValorar = await ValoracionService.PuedeValorarAsync(
                Id, EstadoAuth.Token);

            var cliente = await ClienteService.ObtenerPorUsuarioAsync(
                EstadoAuth.IdUsuario, EstadoAuth.Token);

            tienePerfilCompleto = cliente != null
                && !string.IsNullOrEmpty(cliente.Nombre)
                && !string.IsNullOrEmpty(cliente.Apellidos);
        }
    }

    private void SeleccionarEstrella(int estrella)
    {
        estrellaSeleccionada = estrella;
    }

    private async Task EnviarValoracion()
    {
        if (estrellaSeleccionada == 0) return;

        var dto = new CrearValoracionDto { Puntuacion = estrellaSeleccionada };
        var ok  = await ValoracionService.CrearOActualizarAsync(
            Id, dto, EstadoAuth.Token);

        if (ok)
        {
            Snackbar.Add("¡Valoración enviada correctamente!", Severity.Success);
            resumenValoracion = await ValoracionService.ObtenerResumenAsync(Id);
        }
        else
            Snackbar.Add("Error al enviar la valoración", Severity.Error);
    }

    private async Task EnviarComentario()
    {
        if (nuevoComentario.Length < 10) return;

        var dto       = new CrearComentarioDto { Texto = nuevoComentario };
        var resultado = await ComentarioService.CrearAsync(Id, dto, EstadoAuth.Token);

        if (resultado != null)
        {
            comentarios.Insert(0, resultado);
            nuevoComentario = string.Empty;
            Snackbar.Add("¡Comentario publicado!", Severity.Success);
        }
        else
            Snackbar.Add(
                "Debes completar tu perfil antes de comentar",
                Severity.Warning);
    }

    private async Task EliminarComentario(ComentarioDto comentario)
    {
        var ok = await ComentarioService.EliminarAsync(
            comentario.IdComentario, EstadoAuth.Token);

        if (ok)
        {
            comentarios.Remove(comentario);
            Snackbar.Add("Comentario eliminado", Severity.Info);
        }
    }

    private async Task AnadirAlCarrito()
    {
        if (actividad == null) return;

        var carritoJson = await ObtenerCarritoLocal();
        var carrito     = string.IsNullOrEmpty(carritoJson) || carritoJson == "[]"
            ? new List<ItemCarrito>()
            : System.Text.Json.JsonSerializer.Deserialize<List<ItemCarrito>>(carritoJson)
              ?? new List<ItemCarrito>();

        var itemExistente = carrito
            .FirstOrDefault(i => i.IdActividad == actividad.IdActividad);

        if (itemExistente != null)
            itemExistente.Cantidad += cantidad;
        else
            carrito.Add(new ItemCarrito
            {
                IdActividad = actividad.IdActividad,
                Titulo      = actividad.Titulo,
                Precio      = actividad.Precio,
                Cantidad    = cantidad
            });

        await GuardarCarritoLocal(
            System.Text.Json.JsonSerializer.Serialize(carrito));

        Snackbar.Add($"¡{actividad.Titulo} añadido al carrito!", Severity.Success);
    }

    private async Task<string> ObtenerCarritoLocal()
    {
        return await JS.InvokeAsync<string>("obtenerCarrito", EstadoAuth.IdUsuario);
    }

    private async Task GuardarCarritoLocal(string json)
    {
        await JS.InvokeVoidAsync("guardarCarrito", json, EstadoAuth.IdUsuario);
    }
}
