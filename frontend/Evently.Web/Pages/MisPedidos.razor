@page "/mispedidos"
@using Evently.Web.Models
@using Evently.Web.Services
@inject PedidoService PedidoService
@inject ClienteService ClienteService
@inject EstadoAuthService EstadoAuth
@inject NavigationManager Navegacion
@inject ActividadService ActividadService

<PageTitle>Mis pedidos — Evently</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">

    <MudText Typo="Typo.h4" GutterBottom="true">
        <MudIcon Icon="@Icons.Material.Filled.Receipt" Class="mr-2" />
        Mis pedidos
    </MudText>

    @if (estaCargando)
    {
        <section class="cargandoPedidos">
            <MudProgressCircular Color="Color.Primary"
                                 Indeterminate="true"
                                 Size="Size.Large" />
        </section>
    }
    else if (!string.IsNullOrEmpty(errorMensaje))
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">
            @errorMensaje
            <MudLink Href="/perfil" Class="ml-2">Completar perfil</MudLink>
        </MudAlert>
    }
    else if (listaPedidos.Count == 0)
    {
        <section class="centrado-flex estado-carrito">
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong"
                     Class="mb-4 icono-estado-carrito icono-carrito-vacio" />
            <MudText Typo="Typo.h6" Class="mt-3">Aún no tienes pedidos</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                ¡Explora nuestras actividades y haz tu primera reserva!
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Href="/actividades"
                       StartIcon="@Icons.Material.Filled.EventNote">
                Ver actividades
            </MudButton>
        </section>
    }
    else
    {
        <MudText Typo="Typo.subtitle1" Class="mb-4" Color="Color.Default">
            @listaPedidos.Count @(listaPedidos.Count == 1 ? "pedido" : "pedidos") realizados
        </MudText>

        <section class="rejillaPedidos">
            @foreach (var pedido in pedidosPaginados)
            {
                <article class="tarjetaPedido">

                    <header class="cabeceraTarjetaPedido">
                        <p class="numeroPedido">Pedido #@pedido.IdPedido</p>
                        <p class="fechaPedido">
                            @pedido.FechaConfirm.ToString("dd/MM/yyyy")
                            a las @pedido.FechaConfirm.ToString("HH:mm")
                        </p>
                    </header>

                    <section class="cuerpoTarjetaPedido">
                @foreach (var detalle in pedido.Detalles)
                        {
                            var imagen = imagenesActividades.GetValueOrDefault(detalle.IdActividad);
                            <article class="lineaActividad">
                                <img src="@imagen"
                                     alt="@detalle.TituloActividad"
                                     class="imagenLineaActividad" />
                                <section class="infoLineaActividad">
                                    <p class="tituloLineaActividad">@detalle.TituloActividad</p>
                                    <p class="cantidadLineaActividad">
                                        @detalle.Cantidad ud. × @detalle.PrecioUnitario.ToString("C")
                                    </p>
                                </section>
                                <p class="importeLineaActividad">
                                    @detalle.ImporteLinea.ToString("C")
                                </p>
                            </article>
                        }
                    </section>

                    <footer class="pieTarjetaPedido">
                        <p class="etiquetaTotal">Total del pedido</p>
                        <p class="importeTotal">
                            @pedido.Detalles.Sum(d => d.ImporteLinea).ToString("C")
                        </p>
                    </footer>

                </article>
            }
        </section>
        @if (totalPaginas > 0)
        {
            <section class="controlesDeParginacion">
                <MudText Typo="Typo.body2">Mostrar:</MudText>

                <MudSelect T="int"
                           Value="pedidosPorPagina"
                           ValueChanged="@((int v) => { pedidosPorPagina = v; paginaActual = 1; ActualizarPaginacion(); })"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Class="selectorPagina">
                    @foreach (var opcion in opcionesPagina)
                    {
                        <MudSelectItem T="int" Value="opcion">@opcion</MudSelectItem>
                    }
                </MudSelect>

                <MudIconButton Icon="@Icons.Material.Filled.FirstPage"
                               Color="Color.Primary"
                               Disabled="@(paginaActual == 1)"
                               OnClick="IrPrimeraPagina" />

                <MudPagination Count="totalPaginas"
                               Selected="paginaActual"
                               SelectedChanged="@((int p) => { paginaActual = p; ActualizarPaginacion(); })"
                               Color="Color.Primary" />

                <MudIconButton Icon="@Icons.Material.Filled.LastPage"
                               Color="Color.Primary"
                               Disabled="@(paginaActual == totalPaginas)"
                               OnClick="IrUltimaPagina" />

                <MudText Typo="Typo.body2">
                    @paginaActual / @totalPaginas
                </MudText>
            </section>
        }
    }
</MudContainer>

@code {
    private List<PedidoDto> listaPedidos = new();
    private List<PedidoDto> pedidosPaginados = new();

    private Dictionary<int, string> imagenesActividades = new();
    private string errorMensaje = string.Empty;
    private bool estaCargando = true;

    private int paginaActual = 1;
    private int pedidosPorPagina = 5;
    private int totalPaginas = 0;
    private List<int> opcionesPagina = new() { 5, 10, 20, 50 };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!EstadoAuth.EstaAutenticado)
            {
                await EstadoAuth.CargarDesdeLocalStorageAsync();
                StateHasChanged();
            }

            if (!EstadoAuth.EstaAutenticado)
            {
                Navegacion.NavigateTo("/login");
                return;
            }

            var cliente = await ClienteService.ObtenerPorUsuarioAsync(EstadoAuth.IdUsuario,
                                                                      EstadoAuth.Token);

            if (cliente == null)
            {
                errorMensaje = "No tienes datos personales registrados.";
                estaCargando = false;
                StateHasChanged();
                return;
            }

            listaPedidos = await PedidoService.ObtenerPorClienteAsync(cliente.IdCliente, 
                                                                      EstadoAuth.Token);
            ActualizarPaginacion();

            // Cargamos la imagen de cada actividad que aparece en los pedidos
            var idsActividades = listaPedidos
                .SelectMany(p => p.Detalles)
                .Select(d => d.IdActividad)
                .Distinct();

            foreach (var id in idsActividades)
            {
                var actividad = await ActividadService.ObtenerPorIdAsync(id);
                if (actividad != null && !string.IsNullOrEmpty(actividad.ImagenPrincipal))
                    imagenesActividades[id] = actividad.ImagenPrincipal;
            }

            estaCargando = false;
            StateHasChanged();
        }
    }
    private void ActualizarPaginacion()
    {
        totalPaginas = (int)Math.Ceiling(listaPedidos.Count / (double)pedidosPorPagina);

        pedidosPaginados = listaPedidos
            .OrderByDescending(p => p.FechaConfirm)
            .Skip((paginaActual - 1) * pedidosPorPagina)
            .Take(pedidosPorPagina)
            .ToList();
    }

    private void IrPrimeraPagina()
    {
        paginaActual = 1;
        ActualizarPaginacion();
    }

    private void IrUltimaPagina()
    {
        paginaActual = totalPaginas;
        ActualizarPaginacion();
    }
}